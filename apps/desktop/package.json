{
  "name": "sky-auto-player-desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420",
    "build": "bun run typecheck && bun run build:web",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit",
    "lint:biome": "biome lint .",
    "lint:safety": "eslint . --max-warnings 0",
    "lint": "bun run lint:biome && bun run lint:safety",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:tooling": "node --test scripts/tooling-policy.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "ui:refresh": "node scripts/refresh-ui-snapshots.mjs",
    "test:e2e:bundle": "node scripts/run-bundle-e2e.mjs",
    "test:e2e:bundle:existing": "node scripts/run-bundle-e2e.mjs --reuse-existing-build",
    "benchmark:startup": "node scripts/benchmark-startup.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --ci -- --profile dist",
    "dev:build-info": "node scripts/dev-build-info.mjs",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test:tooling && bun run test && bun run build:web"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tanstack/react-virtual": "3.14.26",
    "lucide-react": "1.67.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "8.1.0",
    "@babel/eslint-parser": "8.0.7",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.7",
    "@biomejs/biome": "2.6.5",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "0.3.0",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "minimatch": "11.0.1"
  }
}
