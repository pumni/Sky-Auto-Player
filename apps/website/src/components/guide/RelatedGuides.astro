---
import type { Locale } from '../../data/site';
import { withBase } from '../../utils/urls';

interface RelatedGuide {
  title: string;
  slug: string;
}

interface Props {
  locale: Locale;
  guides: RelatedGuide[];
}

const { locale, guides } = Astro.props;
const guideBase = locale === 'vi' ? '/vi/guides/' : '/guides/';
---

<section class="related-guides" aria-labelledby="related-guides-title">
  <h2 id="related-guides-title">{locale === 'vi' ? 'Hướng dẫn liên quan' : 'Related guides'}</h2>
  <ul>
    {guides.map((guide) => (
      <li>
        <a href={withBase(`${guideBase}${guide.slug}/`)}>{guide.title}</a>
      </li>
    ))}
  </ul>
</section>

<style>
  @layer components {
    .related-guides {
      margin-block-start: var(--space-7);
      border-block-start: 1px solid var(--line-faint);
      padding-block-start: var(--space-4);
    }

    .related-guides h2 {
      margin-block-end: var(--space-2);
      font-family: var(--font-body);
      font-size: var(--type-body);
      font-weight: 650;
    }

    .related-guides ul {
      display: grid;
      gap: 0.2rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .related-guides a {
      display: inline-flex;
      min-block-size: 44px;
      align-items: center;
      color: var(--color-text-secondary);
      font-size: var(--type-small);
      text-underline-offset: 0.2em;
    }

    .related-guides a:hover {
      color: var(--color-text-primary);
    }
  }
</style>
