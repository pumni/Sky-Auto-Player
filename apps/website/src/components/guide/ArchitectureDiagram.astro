---
interface Props {
  locale?: 'en' | 'vi';
}
const { locale = 'en' } = Astro.props;
const isVi = locale === 'vi';
---

<figure class="arch-diagram">
  <figcaption>
    {isVi ? 'Luồng xử lý của Sky Auto Player' : 'Sky Auto Player processing flow'}
  </figcaption>
  <ol class="arch-diagram__steps">
    <li>
      <strong>{isVi ? 'File Sheet' : 'Sheet file'}</strong>
      {isVi
        ? ' — đọc và parse bởi Sky Auto Player (.json / .skysheet / .txt tương thích JSON)'
        : ' — read and parsed by Sky Auto Player (.json / .skysheet / JSON-compatible .txt)'}
    </li>
    <li>
      <strong>Parser</strong>
      {isVi ? ' — domain thuần túy, không có I/O' : ' — pure domain, no I/O'}
    </li>
    <li>
      <strong>{isVi ? 'Timing Model' : 'Timing model'}</strong>
      {isVi
        ? ' — lên lịch nốt nhạc theo timeline theo frame, có kiểm thử đơn vị'
        : ' — schedules notes on a frame-aligned timeline, covered by unit tests'}
    </li>
    <li>
      <strong>Rust Dispatch</strong>
      {isVi
        ? ' — deadline QPC, wake guard cố định đã hiệu chuẩn; không liên tục điều chỉnh lead'
        : ' — QPC deadlines, calibrated fixed wake guard; no continuous lead adjustment'}
    </li>
    <li>
      <strong>Windows SendInput</strong>
      {isVi
        ? ' — phương thức input duy nhất, không dùng input hook hoặc chèn mã'
        : ' — only input mechanism, no input hooks or code injection'}
    </li>
    <li>
      <span class="arch-diagram__boundary">
        {isVi
          ? 'Ranh giới tiến trình — không truy cập bộ nhớ'
          : 'Process boundary — no memory access'}
      </span>
      <strong>Game</strong>
      {isVi
        ? ' — game lấy mẫu input theo lịch riêng; không bảo đảm đăng ký phím'
        : ' — samples input on its own schedule; receipt is not guaranteed'}
    </li>
  </ol>
</figure>

<style>
  @layer components {
    .arch-diagram {
      margin: var(--space-6) 0;
      padding: var(--space-4);
      border: 1px solid var(--line-default);
      border-radius: var(--radius-md);
      background: var(--color-surface-instrument);
    }
    .arch-diagram figcaption {
      color: var(--color-text-primary);
      font-weight: 650;
    }
    .arch-diagram__steps {
      display: grid;
      gap: var(--space-5);
      padding-inline-start: var(--space-6);
      margin-block-end: 0;
      color: var(--color-text-secondary);
    }
    .arch-diagram__steps li {
      position: relative;
      padding: var(--space-2) var(--space-3);
      background: var(--color-surface-quiet);
      border: 1px solid var(--line-default);
      border-radius: var(--radius-sm);
    }
    .arch-diagram__steps li + li::before {
      position: absolute;
      inset-block-start: -1.55rem;
      inset-inline-start: var(--space-3);
      content: '↓' / '';
      color: var(--color-info);
    }
    .arch-diagram__steps strong {
      color: var(--color-text-primary);
    }
    .arch-diagram__boundary {
      display: block;
      margin-block-end: var(--space-2);
      padding-block-end: var(--space-2);
      border-block-end: 1px dashed var(--color-interactive-border);
      color: var(--color-info);
      font-size: var(--type-label);
    }
  }
</style>
