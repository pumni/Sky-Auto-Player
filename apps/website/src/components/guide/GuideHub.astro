---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../data/site';
import { withBase } from '../../utils/urls';

interface Props {
  locale: Locale;
  guides: CollectionEntry<'guides'>[];
}

const { locale, guides } = Astro.props;
const isVi = locale === 'vi';
const guideBase = isVi ? '/vi/guides/' : '/guides/';

const categories = [
  {
    key: 'getting-started',
    label: isVi ? 'Bắt đầu' : 'Getting started',
  },
  {
    key: 'playback-timing',
    label: isVi ? 'Phát nhạc & timing' : 'Playback & timing',
  },
  {
    key: 'technical-safety',
    label: isVi ? 'Kỹ thuật & an toàn' : 'Technical & safety',
  },
  {
    key: 'support',
    label: isVi ? 'Hỗ trợ' : 'Support',
  },
] as const;

const byCategory = categories.map((category) => ({
  ...category,
  guides: guides
    .filter((guide) => guide.data.category === category.key)
    .sort((a, b) => a.data.order - b.data.order),
}));
---

<div class="guide-hub">
  {byCategory
    .filter((category) => category.guides.length > 0)
    .map((category) => (
      <section class="guide-hub__category" aria-labelledby={`guide-category-${category.key}`}>
        <h2 id={`guide-category-${category.key}`}>{category.label}</h2>
        <ul>
          {category.guides.map((guide) => (
            <li>
              <a href={withBase(`${guideBase}${guide.data.slug}/`)}>
                {guide.data.title}
                <span aria-hidden="true"> ↗</span>
              </a>
              <p>{guide.data.summary}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
</div>

<style>
  @layer components {
    .guide-hub {
      display: grid;
      gap: var(--space-6);
    }

    .guide-hub__category {
      min-inline-size: 0;
    }

    .guide-hub__category h2 {
      margin-block-end: var(--space-2);
      font-family: var(--font-body);
      font-size: var(--type-h3);
      font-weight: 650;
    }

    .guide-hub__category ul {
      display: grid;
      margin: 0;
      padding: 0;
      border-block-start: 1px solid var(--line-faint);
      list-style: none;
    }

    .guide-hub__category li {
      min-inline-size: 0;
      border-block-end: 1px solid var(--line-faint);
    }

    .guide-hub__category a {
      display: flex;
      min-block-size: 44px;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-2);
      padding-block: 0.4rem;
      color: var(--color-text-secondary);
      font-size: var(--type-small);
      line-height: 1.45;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.2em;
    }

    .guide-hub__category p {
      margin: 0 0 var(--space-4);
      color: var(--color-text-secondary);
      font-size: var(--type-body);
      line-height: var(--leading-body);
    }

    .guide-hub__category a:hover {
      color: var(--color-text-primary);
    }

    .guide-hub__category a span {
      flex: 0 0 auto;
      color: var(--color-text-tertiary);
    }

    @media (min-width: 48rem) {
      .guide-hub {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        column-gap: var(--space-7);
        row-gap: var(--space-6);
      }
    }
  }
</style>
