---
import Kicker from './Kicker.astro';

interface Props {
  title: string;
  kicker: string;
  description?: string;
  titleId: string;
}

const { title, kicker, description, titleId } = Astro.props;
---

<div class="ui-section-intro">
  <Kicker>{kicker}</Kicker>
  <h2 id={titleId} class="ui-section-title">
    {title}
  </h2>
  {description && <p class="ui-section-copy">{description}</p>}
</div>
