---
import type { Locale } from '../../data/site';
import { SITE } from '../../data/site';
import { localizedPath, withBase } from '../../utils/urls';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isVi = locale === 'vi';
const otherLocalePath = localizedPath(Astro.url.pathname, isVi ? 'en' : 'vi');
---

<footer class="site-footer">
  <div class="container site-footer__layout">
    <div class="site-footer__identity">
      <a class="site-footer__brand" href={withBase(isVi ? '/vi/' : '/')}>
        <img src={withBase('/favicon.svg')} alt="" width="24" height="24" aria-hidden="true" />
        <span>Sky Auto Player</span>
      </a>
      <p>
        {isVi
          ? 'Mã nguồn mở theo GNU GPL v3.0 · Dự án cộng đồng không chính thức cho cộng đồng âm nhạc Sky.'
          : 'Open source under GNU GPL v3.0 · An unofficial community project for Sky music players.'}
      </p>
    </div>
    <nav class="site-footer__links" aria-label={isVi ? 'Liên kết chân trang' : 'Footer links'}>
      <div class="site-footer__group">
        <span class="site-footer__group-title">{isVi ? 'Tài nguyên' : 'Resources'}</span>
        <a href={SITE.releaseHistoryUrl}>{isVi ? 'Bản phát hành' : 'Releases'}</a>
        <a href={withBase(isVi ? '/vi/guides/' : '/guides/')}>{isVi ? 'Hướng dẫn' : 'Guides'}</a>
        <a href={withBase(isVi ? '/vi/faq/' : '/faq/')}>FAQ</a>
      </div>
      <div class="site-footer__group">
        <span class="site-footer__group-title">{isVi ? 'Dự án' : 'Project'}</span>
        <a href={SITE.repositoryUrl}>{isVi ? 'Mã nguồn' : 'Source'}</a>
        <a href={`${SITE.repositoryUrl}/blob/main/LICENSE`}>{isVi ? 'Giấy phép' : 'License'}</a>
        <a href={`${SITE.repositoryUrl}/issues`}>{isVi ? 'Báo lỗi' : 'Issues'}</a>
      </div>
      <div class="site-footer__group">
        <span class="site-footer__group-title">{isVi ? 'Ngôn ngữ' : 'Language'}</span>
        <a href={otherLocalePath} lang={isVi ? 'en' : 'vi'} hreflang={isVi ? 'en' : 'vi'}>
          {isVi ? 'English' : 'Tiếng Việt'}
        </a>
      </div>
    </nav>
  </div>
</footer>

<style>
  @layer components {
    .site-footer {
      border-top: 1px solid var(--line-faint);
      padding-block: var(--section-compact);
      color: var(--color-text-tertiary);
      font-size: var(--type-small);
    }

    .site-footer__layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: clamp(2rem, 4vw, 4rem);
      align-items: start;
    }

    .site-footer__identity {
      display: grid;
      gap: 1rem;
    }

    .site-footer__identity p {
      max-inline-size: 34rem;
      line-height: 1.7;
    }

    .site-footer__brand {
      display: inline-flex;
      width: fit-content;
      min-height: 44px;
      align-items: center;
      gap: var(--space-2);
      color: var(--color-text-primary);
      font-weight: 650;
    }

    .site-footer__brand img {
      width: 24px;
      height: 24px;
    }

    .site-footer__links {
      display: grid;


      gap: 1.5rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .site-footer__group {
      display: grid;

      gap: 0.125rem;


      align-content: start;
      justify-items: start;
    }

    .site-footer__group-title {
      color: var(--color-text-primary);
      font-size: var(--type-small);
      font-weight: 650;
      margin-block-end: 0.5rem;
    }

    @media (min-width: 40rem) {
      .site-footer__links {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    .site-footer__links a {
      display: inline-flex;
      min-height: 44px;
      align-items: center;
      color: var(--color-text-secondary);
      text-decoration: underline;
      text-decoration-color: var(--line-default);
      text-underline-offset: 0.2em;
    }

    .site-footer__links a:hover,
    .site-footer__links a:focus-visible {
      color: var(--color-text-primary);
      text-decoration-color: var(--color-focus);
    }

    @media (max-width: 48rem) {
      .site-footer__layout {
        grid-template-columns: 1fr;
        align-items: start;
      }
    }

    @media (forced-colors: active) {
      .site-footer__links a {
        color: LinkText;
        text-decoration: underline;
      }
    }
  }
</style>
