---
import type { HomeContent } from '../../data/home.types';

interface Props {
  data: HomeContent['benefits'];
}

const { data } = Astro.props;
---

<section
  class="benefits section-shell section-shell--transition"
  aria-label={data.kicker}
  data-home-section="benefits"
>
  <div class="container">
    <p class="benefits__eyebrow">{data.kicker}</p>
    <ul class="benefits__list">
      {data.items.map((item) => (
        <li class="benefit">
          <span class="benefit__number">{item.number}</span>
          <h2>{item.title}</h2>
          <p>{item.description}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  @layer components {
    .benefits {
      border-block: 1px solid var(--line-faint);
      background: var(--color-surface-quiet);
    }

    .benefits__eyebrow {
      margin-block-end: var(--space-5);
      color: var(--color-text-tertiary);
      font-size: var(--type-label);
      font-weight: 650;
      letter-spacing: 0.07em;
      text-transform: uppercase;
    }

    :lang(vi) .benefits__eyebrow {
      letter-spacing: 0;
      text-transform: none;
    }

    .benefits__list {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      margin: 0;
      padding: 0;
      border-block-start: 1px solid var(--line-default);
      list-style: none;
    }

    .benefit {
      min-inline-size: 0;
      padding: var(--space-5) var(--space-3) var(--space-6) 0;
      border-block-end: 1px solid var(--line-faint);
    }

    .benefit__number {
      display: block;
      margin-block-end: var(--space-4);
      color: var(--color-action);
      font-family: var(--font-mono);
      font-size: var(--type-micro);
    }

    .benefit h2 {
      margin-block-end: var(--space-2);
      font-family: var(--font-body);
      font-size: var(--type-h3);
      font-weight: 600;
      letter-spacing: -0.025em;
    }

    .benefit p {
      max-inline-size: 34ch;
      color: var(--color-text-tertiary);
      font-size: var(--type-small);
    }

    @media (min-width: 40rem) {
      .benefits__list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .benefit:nth-child(odd) {
        padding-inline-end: var(--space-5);
        border-inline-end: 1px solid var(--line-faint);
      }

      .benefit:nth-child(even) {
        padding-inline-start: var(--space-5);
      }

      .benefit:nth-last-child(-n + 2) {
        border-block-end: 0;
      }
    }

    @media (min-width: 72rem) {
      .benefits__list {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }

      .benefit {
        border-block-end: 0;
      }

      .benefit:nth-child(odd),
      .benefit:nth-child(even) {
        padding-inline: var(--space-5);
        border-inline-end: 1px solid var(--line-faint);
      }

      .benefit:first-child {
        padding-inline-start: 0;
      }

      .benefit:last-child {
        padding-inline-end: 0;
        border-inline-end: 0;
      }
    }
  }
</style>
