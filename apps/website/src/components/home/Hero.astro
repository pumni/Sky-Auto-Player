---
import type { HomeContent } from '../../data/home.types';
import { SITE } from '../../data/site';

interface Props {
  data: HomeContent['hero'];
  downloadCta: string;
  locale: 'en' | 'vi';
}

const { data, downloadCta, locale } = Astro.props;
---

<section
  id="top"
  class:list={['hero container', locale === 'vi' && 'hero--vi']}
  aria-labelledby="hero-title"
  data-home-section="hero"
>
  <div class="hero__headline">
    <h1 id="hero-title">{data.title}</h1>
  </div>
  <div class="hero__copy">
    <p class="hero__description">{data.description}</p>
    <div class="hero__actions">
      <a class="button button--primary hero__primary" href={SITE.stableReleaseUrl}>
        {downloadCta}
      </a>
      <a class="button hero__secondary" href="#product">
        {data.secondaryCta}
        <span aria-hidden="true">↓</span>
      </a>
    </div>
    <p class="hero__meta">{data.meta}</p>
    <p class="hero__risk">{data.riskNote}</p>
  </div>
</section>

<style>
  @layer components {
    .hero {
      display: grid;
      align-items: center;
      gap: 1.75rem;
      text-align: start;
    }
    .hero h1 {
      max-inline-size: 14ch;
      margin: 0;
      font-size: clamp(2.75rem, 2rem + 3.4vw, 5rem);
      line-height: 1.04;
      letter-spacing: -0.055em;
      text-wrap: balance;
      font-family: var(--font-body);
      font-weight: 650;
    }
    .hero--vi h1 {
      font-size: clamp(2.5rem, 1.9rem + 3.2vw, 4.75rem);
      line-height: 1.12;
      letter-spacing: -0.045em;
    }
    .hero__description {
      max-inline-size: 43ch;
      margin: 0;
      color: var(--color-text-secondary);
      font-size: var(--home-lead);
      line-height: 1.65;
    }
    .hero__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-block-start: 1.5rem;
      align-items: center;
    }
    .hero__actions .button {
      min-block-size: 48px;
      padding-inline: 1rem;
    }
    .hero__secondary {
      gap: 0.5rem;
      color: var(--color-text-primary);
      text-decoration: underline;
      text-decoration-color: var(--color-info);
      text-underline-offset: 0.25em;
    }

    .hero__secondary:hover {
      color: var(--color-action);
      text-decoration-color: currentColor;
    }

    .hero__meta,
    .hero__risk {
      margin: 0.75rem 0 0;
      color: var(--color-text-secondary);
      font-size: var(--type-small);
      line-height: 1.5;
    }
    .hero__risk {
      max-inline-size: 53ch;
    }
    @media (min-width: 64rem) {
      .hero {
        grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
        gap: clamp(2.5rem, 5vw, 5rem);
      }
      .hero__copy {
        padding-block-end: 0.25rem;
      }

      .hero__actions .hero__secondary {
        padding-inline: 0.25rem;
      }
    }
    @media (max-width: 39.99rem) {
      .hero {
        gap: 1rem;
      }
      .hero h1,
      .hero--vi h1 {
        max-inline-size: none;
        font-size: clamp(2.125rem, 1.3rem + 3vw, 2.75rem);
        line-height: 1.12;
      }
      .hero__actions {
        margin-block-start: 1rem;
        gap: 0.5rem;
      }
      .hero__actions .button {
        min-block-size: 44px;
        padding-inline: 0.6rem;
        font-size: 0.875rem;
      }
      .hero__meta,
      .hero__risk {
        margin-block-start: 0.5rem;
      }
    }
  }
</style>
