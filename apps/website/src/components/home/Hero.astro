---
import type { HomeContent } from '../../data/home.types';
import { SITE } from '../../data/site';

interface Props {
  data: HomeContent['hero'];
  downloadCta: string;
  locale: 'en' | 'vi';
}

const { data, downloadCta, locale } = Astro.props;
---

<section
  id="top"
  class:list={['hero container', locale === 'vi' && 'hero--vi']}
  aria-labelledby="hero-title"
  data-home-section="hero"
>
  <h1 id="hero-title">
    {data.titleStart}
    <span>{data.titleEmphasis}</span>
    {data.titleEnd}
  </h1>
  <p class="hero__description">{data.description}</p>
  <div class="hero__actions">
    <a class="button button--primary hero__primary" href={SITE.stableReleaseUrl}>
      {downloadCta}
    </a>
    <a class="button button--secondary hero__secondary" href="#product">
      {data.secondaryCta}
    </a>
  </div>
  <p class="hero__meta">{data.meta}</p>
  <p class="hero__risk">{data.riskNote}</p>
</section>

<style>
  @layer components {
    .hero {
      max-inline-size: 52rem;
      text-align: center;
    }

    .hero h1 {
      margin: 0;
      font-size: clamp(2.25rem, 1.5rem + 3.7vw, 4.5rem);
      letter-spacing: -0.025em;
      line-height: 1.08;
      text-wrap: balance;
    }

    .hero h1 span {
      color: var(--color-action-hover);
    }

    .hero--vi h1 {
      letter-spacing: 0;
      font-size: clamp(2.25rem, 1.5rem + 3.1vw, 4.25rem);
      line-height: 1.16;
    }

    .hero__description {
      max-inline-size: 65ch;
      margin: clamp(1rem, 1.4vw, 1.25rem) auto 0;
      color: var(--color-text-secondary);
      font-size: var(--home-lead);
      line-height: 1.5;
    }

    .hero--vi .hero__description {
      font-size: clamp(1rem, 0.9rem + 0.3vw, 1.125rem);
    }

    .hero__actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.75rem clamp(0.5rem, 1.2vw, 1rem);
      margin-block-start: clamp(1rem, 1.4vw, 1.25rem);
    }

    .hero__actions .button {
      min-block-size: 44px;
      padding-inline: clamp(0.5rem, 1.6vw, 1.25rem);
    }

    .hero__meta,
    .hero__risk {
      margin: 0.625rem auto 0;
      color: var(--color-text-secondary);
      font-size: var(--type-small);
      line-height: 1.5;
    }

    .hero__risk {
      max-inline-size: 78ch;
    }
  }
</style>
