---
import type { HomeContent } from '../../data/home.types';
import { SITE } from '../../data/site';

interface Props {
  data: HomeContent['hero'];
  downloadCta: string;
  locale: 'en' | 'vi';
}

const { data, downloadCta, locale } = Astro.props;
---

<section
  id="top"
  class:list={['hero', locale === 'vi' && 'hero--vi']}
  aria-labelledby="hero-title"
  data-home-section="hero"
>
  <h1 id="hero-title">{data.title}</h1>
  <p class="hero__description">{data.description}</p>
  <div class="hero__actions">
    <a class="button button--primary hero__primary" href={SITE.releaseUrl}>
      {downloadCta}
    </a>
    <a class="hero__secondary" href="#product">
      {data.secondaryCta}
    </a>
  </div>
  <p class="hero__meta">{data.meta}</p>
  <p class="hero__risk">{data.riskNote}</p>
</section>

<style>
  @layer components {
    .hero {
      min-inline-size: 0;
      padding-block: 1rem;
    }

    .hero h1 {
      margin-block-end: 1.25rem;
      letter-spacing: -0.025em;
      line-height: 1.08;
      max-inline-size: 17ch;
      color: var(--color-text-primary);
      text-wrap: balance;
    }

    .hero h1::first-line {
      color: var(--color-action-hover);
    }

    .hero--vi h1 {
      letter-spacing: 0;
      line-height: 1.16;
      max-inline-size: 15ch;
    }

    .hero__description {
      max-inline-size: 42ch;
      margin-block-end: 1.5rem;
      color: var(--color-text-secondary);
      font-size: var(--type-lead);
      line-height: 1.5;
    }

    .hero__actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1.25rem;
    }

    .hero__primary {
      min-block-size: 3rem;
      padding-inline: 1.25rem;
      border-radius: var(--radius-sm);
    }

    .hero__secondary {
      display: inline-flex;
      min-block-size: 44px;
      align-items: center;
      color: var(--color-text-secondary);
      text-decoration: underline;
      text-decoration-color: var(--line-default);
      text-underline-offset: 0.25em;
    }

    .hero__secondary:hover {
      color: var(--color-text-primary);
      text-decoration-color: var(--color-focus);
    }

    .hero__meta {
      margin-block-start: 0.875rem;
      color: var(--color-text-tertiary);
      font-size: var(--type-small);
    }

    .hero__risk {
      max-inline-size: 48ch;
      margin-block-start: 1.25rem;
      color: var(--color-text-secondary);
      font-size: var(--type-small);
      line-height: 1.5;
    }

    @media (min-width: 64rem) {
      .hero {
        padding-block-start: clamp(1rem, 3vw, 3rem);
      }
    }

    @media (max-width: 39.99rem) {
      .hero {
        padding-block: 0;
      }

      .hero__actions {
        gap: 0.75rem 1rem;
      }

      .hero__risk {
        margin-block-start: 1rem;
      }
    }
  }
</style>
