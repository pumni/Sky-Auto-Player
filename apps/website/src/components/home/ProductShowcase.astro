---
import type { HomeContent } from '../../data/home.types';
import { withBase } from '../../utils/urls';

interface Props {
  data: HomeContent['product'];
}

const { data } = Astro.props;
const defaultView = data.views[0];
---

<section
  id="product"
  class="container product-showcase"
  aria-labelledby="product-title"
  data-home-section="product"
  data-product-showcase
  data-pending-message={data.pendingMessage}
  data-error-message={data.errorMessage}
>
  <div class="product-showcase__workspace">
    <div class="product-showcase__header">
      <header class="product-showcase__intro">
        <h2 id="product-title">{data.title}</h2>
        <p>{data.description}</p>
      </header>
      <div class="product-selector" role="group" aria-label={data.selectorLabel} hidden>
        {data.views.map((view, index) => (
          <button
            class="product-selector__button"
            type="button"
            aria-pressed={index === 0 ? 'true' : 'false'}
            data-product-view
            data-src={withBase(view.src)}
            data-alt={view.alt}
            data-caption={view.caption}
          >
            {view.label}
          </button>
        ))}
      </div>
    </div>

    <figure class="product-showcase__figure">
      <p class="product-showcase__provenance">{data.captureNote}</p>
      <img
        class="product-showcase__image"
        src={withBase(defaultView.src)}
        alt={defaultView.alt}
        width="1366"
        height="768"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        data-product-image
      />
      <figcaption class="product-showcase__caption">
        <span data-product-caption>{defaultView.caption}</span>
        <a href={withBase(defaultView.src)} target="_blank" rel="noreferrer" data-product-full-size>
          {data.fullSizeLabel}
          <span aria-hidden="true"> ↗</span>
        </a>
      </figcaption>
    </figure>

    <p class="product-showcase__status" role="status" data-product-status></p>

    <ul class="product-showcase__fallback" aria-label={data.fallbackLabel}>
      {data.views.map((view) => (
        <li>
          <a href={withBase(view.src)} target="_blank" rel="noreferrer">
            {view.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
  <div class="product-showcase__features">
    {data.features.map((feature) => (
      <div>
        <h3>{feature.title}</h3>
        <p>{feature.description}</p>
      </div>
    ))}
  </div>
</section>

<style>
  @layer components {
    .product-showcase__workspace {
      padding: clamp(0.75rem, 2.4vw, 1.75rem);
      background: var(--color-surface-instrument);
      border: 1px solid var(--line-default);
      border-radius: 1rem;
      box-shadow: none;
    }
    .product-showcase__header {
      display: grid;
      gap: 1rem;
      margin-block-end: 1.25rem;
    }
    .product-showcase__intro h2 {
      margin: 0;
      font-family: var(--font-body);
      font-weight: 600;
      letter-spacing: -0.025em;
      font-size: clamp(1.25rem, 1rem + 1vw, 2rem);
      line-height: 1.2;
    }
    .product-showcase__intro p {
      margin: 0.375rem 0 0;
      color: var(--color-text-secondary);
      font-size: var(--type-small);
    }
    .product-selector[hidden],
    .product-showcase__fallback[hidden] {
      display: none;
    }
    .product-selector {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.25rem;
      padding: 0.25rem;
      border: 1px solid var(--line-default);
      border-radius: 0.65rem;
      background: var(--color-page);
    }
    .product-selector__button {
      min-block-size: 44px;
      padding: 0.45rem 0.3rem;
      border: 1px solid transparent;
      border-radius: var(--radius-sm);
      background: transparent;
      color: var(--color-text-secondary);
      cursor: pointer;
      font-size: var(--type-small);
      font-weight: 500;
      line-height: 1.25;
      overflow-wrap: anywhere;
      transition:
        background-color var(--duration-fast) var(--ease-standard),
        color var(--duration-fast) var(--ease-standard),
        border-color var(--duration-fast) var(--ease-standard);
    }
    .product-selector__button:hover {
      border-color: var(--color-interactive-border);
      color: var(--color-text-primary);
      background: var(--color-surface-quiet);
    }
    .product-selector__button[aria-pressed='true'] {
      border-color: var(--color-interactive-border);
      background: var(--color-surface-active);
      color: var(--color-text-primary);
      box-shadow: inset 0 -2px var(--color-interactive-selected);
      font-weight: 650;
    }
    .product-selector__button[data-pending] {
      border-color: var(--color-interactive-border);
      border-style: dashed;
    }
    .product-showcase__figure {
      margin: 0;
    }
    .product-showcase__image {
      display: block;
      border: 1px solid var(--line-default);
      border-radius: 0.65rem;
      background: var(--color-surface-quiet);
      inline-size: 100%;
      block-size: auto;
      aspect-ratio: 1366 / 768;
      object-fit: contain;
    }
    .product-showcase__caption {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem 1rem;
      padding-block-start: 1rem;
      color: var(--color-text-secondary);
      font-size: var(--type-body);
    }
    .product-showcase__caption a {
      display: inline-flex;
      min-block-size: 2.75rem;
      align-items: center;
      color: var(--color-text-primary);
      font-size: var(--type-small);
      text-decoration: underline;
      text-decoration-color: var(--color-info);
      text-underline-offset: 0.2em;
    }
    .product-showcase__caption a:hover {
      text-decoration-color: var(--color-focus);
    }
    .product-showcase__provenance {
      margin: 0 0 0.625rem;
      color: var(--color-text-secondary);
      font-size: clamp(0.8125rem, 0.75rem + 0.15vw, 0.875rem);
      line-height: 1.45;
    }
    .product-showcase__status {
      margin: 0;
      color: var(--color-info);
      font-size: var(--type-small);
    }
    .product-showcase__status:not(:empty) {
      margin-block-start: var(--space-2);
    }
    .product-showcase__status[data-error] {
      color: var(--color-error);
    }
    .product-showcase__fallback {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 1rem;
      margin: 0.75rem 0 0;
      padding: 0;
      list-style: none;
    }
    .product-showcase__fallback a {
      display: inline-flex;
      min-block-size: 44px;
      align-items: center;
      color: var(--color-action);
    }
    .product-showcase__features {
      display: grid;
      margin-block-start: clamp(2rem, 4vw, 3.5rem);
      gap: 1.5rem;
    }
    .product-showcase__features > div {
      padding: 1.25rem 0 0;
      border-block-start: 1px solid var(--line-default);
    }
    .product-showcase__features h3 {
      margin: 0 0 0.75rem;
      font-size: clamp(1.25rem, 1rem + 0.6vw, 1.65rem);
      line-height: 1.35;
    }
    .product-showcase__features p {
      max-inline-size: 56ch;
      margin: 0;
      color: var(--color-text-secondary);
      font-size: var(--type-body);
      line-height: 1.7;
    }
    @media (min-width: 48rem) {
      .product-showcase__features {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: clamp(2rem, 5vw, 4rem);
      }
    }
    @media (min-width: 64rem) {
      .product-showcase__header {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
        align-items: center;
        gap: 2rem;
      }
    }
    @media (max-width: 39.99rem) {
      .product-showcase__header {
        gap: 0.75rem;
        margin-block-end: 0.75rem;
      }
      .product-showcase__intro p {
        margin-block-start: 0.25rem;
      }
      .product-showcase__caption {
        display: grid;
        justify-content: start;
        gap: 0.25rem;
        padding-block-start: 0.75rem;
      }
    }
    @media (forced-colors: active) {
      .product-showcase__workspace,
      .product-showcase__features > div,
      .product-selector {
        border-color: CanvasText;
      }
      .product-selector__button[aria-pressed='true'] {
        outline: 1px solid Highlight;
      }
    }
  }
</style>

<script>
  const showcase = document.querySelector<HTMLElement>('[data-product-showcase]');
  if (showcase) {
    const controls = showcase.querySelector<HTMLElement>('.product-selector');
    const fallback = showcase.querySelector<HTMLElement>('.product-showcase__fallback');
    const image = showcase.querySelector<HTMLImageElement>('[data-product-image]');
    const link = showcase.querySelector<HTMLAnchorElement>('[data-product-full-size]');
    const caption = showcase.querySelector<HTMLElement>('[data-product-caption]');
    const status = showcase.querySelector<HTMLElement>('[data-product-status]');
    const buttons = Array.from(showcase.querySelectorAll<HTMLButtonElement>('[data-product-view]'));
    if (controls && fallback && image && link && caption && status && buttons[0]) {
      let committed = buttons[0];
      let imageState: 'loading' | 'ready' | 'failed' = 'loading';
      let selectionFailed = false;
      let pending = false;
      controls.hidden = false;
      const updateFeedback = () => {
        const failed = imageState === 'failed' || selectionFailed;
        status.toggleAttribute('data-error', failed && !pending);
        const message = pending
          ? (showcase.dataset.pendingMessage ?? '')
          : failed
            ? (showcase.dataset.errorMessage ?? '')
            : '';
        if (status.textContent !== message) status.textContent = message;
        if (!failed && fallback.contains(document.activeElement)) {
          committed.focus({ preventScroll: true });
        }
        fallback.hidden = !failed;
      };
      const initial = new AbortController();
      const settleInitial = () => {
        initial.abort();
        imageState = image.naturalWidth > 0 ? 'ready' : 'failed';
        committed.setAttribute('aria-pressed', String(imageState === 'ready'));
        updateFeedback();
      };
      image.addEventListener('load', settleInitial, { signal: initial.signal });
      image.addEventListener('error', settleInitial, { signal: initial.signal });
      if (image.complete) settleInitial();
      else updateFeedback();

      let cancelPending = () => {};
      controls.addEventListener('click', (event) => {
        const button =
          event.target instanceof Element
            ? event.target.closest<HTMLButtonElement>('[data-product-view]')
            : null;
        if (!button) return;
        const { src, alt, caption: nextCaption } = button.dataset;
        if (!src || !alt || !nextCaption) return;
        cancelPending();
        if (button === committed && imageState !== 'failed') {
          selectionFailed = false;
          updateFeedback();
          return;
        }
        const request = new AbortController();
        const preview = new Image();
        const timer = window.setTimeout(() => {
          button.setAttribute('data-pending', '');
          pending = true;
          updateFeedback();
        }, 150);
        cancelPending = () => {
          request.abort();
          window.clearTimeout(timer);
          button.removeAttribute('data-pending');
          pending = false;
          cancelPending = () => {};
        };
        const commitSelection = () => {
          cancelPending();
          initial.abort();
          image.src = src;
          image.alt = alt;
          link.href = src;
          caption.textContent = nextCaption;
          committed.setAttribute('aria-pressed', 'false');
          button.setAttribute('aria-pressed', 'true');
          committed = button;
          imageState = 'ready';
          selectionFailed = false;
          updateFeedback();
        };
        preview.addEventListener('load', commitSelection, { signal: request.signal });
        preview.addEventListener(
          'error',
          () => {
            cancelPending();
            selectionFailed = true;
            updateFeedback();
          },
          { signal: request.signal },
        );
        preview.src = src;
        if (preview.complete && preview.naturalWidth > 0) commitSelection();
      });
      window.addEventListener('pagehide', (event) => {
        cancelPending();
        updateFeedback();
        if (!event.persisted) initial.abort();
      });
    }
  }
</script>
