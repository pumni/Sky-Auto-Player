---
import type { HomeContent } from '../../data/home.types';
import SectionIntro from '../ui/SectionIntro.astro';

interface Props {
  data: HomeContent['technical'];
}

const { data } = Astro.props;
---

<section
  id="timing-model"
  class="technical-model section-shell section-shell--feature section-shell--bordered"
  aria-labelledby="technical-model-title"
  data-home-section="technical-model"
>
  <div class="container technical-model__layout">
    <SectionIntro
      kicker={data.kicker}
      title={data.title}
      description={data.description}
      titleId="technical-model-title"
    />
    <div class="model-table-wrap">
      <table class="model-table">
        <thead>
          <tr>
            <th scope="col" class="model-table__dimension">
              <span class="sr-only">{data.dimensionHeader}</span>
            </th>
            <th scope="col">{data.fixedDelayTitle}</th>
            <th scope="col" class="model-table__sheet">
              {data.sheetTitle}
            </th>
          </tr>
        </thead>
        <tbody>
          {data.dimensions.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              <td>{row.fixedDelay}</td>
              <td>{row.sheet}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="technical-model__boundary">
      <span aria-hidden="true">↳</span>
      {data.boundaryNote}
    </p>
  </div>
</section>

<style>
  @layer components {
    .technical-model {
      background: var(--color-surface-quiet);
    }

    .technical-model__layout {
      display: grid;
      gap: var(--space-7);
    }

    .model-table-wrap {
      max-inline-size: 100%;
      overflow-x: auto;
      border-block-start: 1px solid var(--line-default);
    }

    .model-table {
      inline-size: 100%;
      min-inline-size: 38rem;
      border-collapse: collapse;
      text-align: start;
    }

    .model-table th,
    .model-table td {
      padding: var(--space-4);
      border-block-end: 1px solid var(--line-faint);
      vertical-align: top;
    }

    .model-table thead th {
      color: var(--color-text-primary);
      font-family: var(--font-body);
      font-size: var(--type-small);
      font-weight: 700;
      line-height: var(--leading-ui);
    }

    .model-table tbody th {
      width: 18%;
      color: var(--color-text-tertiary);
      font-size: var(--type-small);
      font-weight: 600;
    }

    .model-table td {
      width: 41%;
      color: var(--color-text-secondary);
      font-size: var(--type-small);
    }

    .model-table__sheet {
      background: color-mix(in oklch, var(--color-action) 5%, transparent);
    }

    .technical-model__boundary {
      display: grid;
      grid-template-columns: 1.25rem minmax(0, 1fr);
      gap: var(--space-3);
      max-inline-size: 68ch;
      color: var(--color-text-tertiary);
      font-size: var(--type-small);
    }

    .technical-model__boundary span {
      color: var(--color-action);
    }

    @media (min-width: 64rem) {
      .technical-model__layout {
        grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
        gap: var(--grid-gap);
        align-items: start;
      }

      .technical-model__boundary {
        grid-column: 2;
      }

      .model-table th,
      .model-table td {
        padding: var(--space-5);
      }
    }

    @media (forced-colors: active) {
      .model-table__sheet {
        outline: 1px solid CanvasText;
      }
    }
  }
</style>
