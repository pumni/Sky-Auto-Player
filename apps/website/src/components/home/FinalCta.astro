---
import type { HomeContent } from '../../data/home.types';
import { SITE } from '../../data/site';

interface Props {
  data: HomeContent['finalCta'];
}

const { data } = Astro.props;
---

<section
  class="final-cta section-shell section-shell--feature"
  aria-labelledby="final-title"
  data-home-section="closing-cta"
>
  <div class="container final-cta__layout">
    <div class="final-cta__copy">
      <p class="final-cta__eyebrow">Sky Auto Player · Windows 11</p>
      <h2 id="final-title">{data.title}</h2>
      <p class="final-cta__description">{data.description}</p>
    </div>
    <div class="final-cta__actions">
      <a class="button button--primary final-cta__primary" href={SITE.releaseUrl}>
        <span>{data.primaryCta}</span>
        <span class="final-cta__destination">{data.primaryDestination}</span>
      </a>
      <a class="button button--secondary" href={SITE.repositoryUrl}>
        {data.secondaryCta}
      </a>
    </div>
  </div>
</section>

<style>
  @layer components {
    .final-cta {
      position: relative;
      overflow: clip;
      border-block: 1px solid var(--line-default);
      background:
        radial-gradient(ellipse at 96% 90%, rgb(239 202 120 / 10%), transparent 43%),
        var(--color-surface-quiet);
    }

    .final-cta__layout {
      display: grid;
      gap: var(--space-6);
      align-items: end;
    }

    .final-cta__copy,
    .final-cta__actions {
      position: relative;
      z-index: 1;
    }

    .final-cta__eyebrow {
      margin-block-end: var(--space-3);
      color: var(--color-action);
      font-family: var(--font-mono);
      font-size: var(--type-micro);
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .final-cta h2 {
      max-inline-size: 13ch;
      margin-block-end: var(--space-4);
      font-size: clamp(2.5rem, 5vw, 5rem);
      letter-spacing: -0.045em;
    }

    .final-cta__description {
      max-inline-size: 54ch;
      color: var(--color-text-secondary);
      font-size: var(--type-lead);
    }

    .final-cta__actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3);
    }

    .final-cta__primary {
      display: inline-flex;
      min-block-size: 3.75rem;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 0.125rem;
      padding-block: var(--space-2);
    }

    .final-cta__destination {
      color: color-mix(in oklch, var(--color-text-on-action) 78%, transparent);
      font-size: var(--type-micro);
      font-weight: 500;
      line-height: 1.2;
    }

    @media (min-width: 64rem) {
      .final-cta__layout {
        grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
        gap: var(--grid-gap);
      }

      .final-cta__actions {
        justify-content: flex-start;
      }
    }

    @media (max-width: 39.99rem) {
      .final-cta__actions {
        flex-direction: column;
        align-items: stretch;
      }

      .final-cta__actions .button {
        width: 100%;
      }
    }
  }
</style>
