---
import type { HomeContent } from '../../data/home.types';
import { SITE } from '../../data/site';
import { withBase } from '../../utils/urls';

interface Props {
  data: HomeContent['trust'];
  locale: 'en' | 'vi';
  downloadCta: string;
}

const { data, locale, downloadCta } = Astro.props;
const safetyUrl = withBase(locale === 'vi' ? '/vi/faq/#account-safety' : '/faq/#account-safety');
---

<section
  id="technical"
  class="trust-download"
  aria-labelledby="trust-download-title"
  data-home-section="trust-download"
>
  <div class="container trust-download__layout">
    <div class="trust-download__lead">
      <h2 id="trust-download-title">{data.title}</h2>
      <a class="button button--primary trust-download__button" href={SITE.stableReleaseUrl}>
        {downloadCta}
      </a>
      <p class="trust-download__destination">GitHub Releases</p>
    </div>

    <div class="trust-download__details">
      <div>
        <p>{data.installerGuidance}</p>
        <p>{data.installScope}</p>
        <p>{data.signingValue}</p>
      </div>
      <div>
        <p class="trust-download__safety">
          {data.safetyNote}
          <a href={safetyUrl}>{data.safetyLink}</a>
        </p>

        <nav id="faq-preview" class="trust-download__support" aria-label={data.supportLabel}>
          <span>{data.supportLabel}</span>
          {data.supportLinks.map((link) => (
            <a href={withBase(link.href)}>{link.label}</a>
          ))}
        </nav>
      </div>
    </div>
  </div>
</section>

<style>
  @layer components {
    .trust-download__layout {
      display: grid;
      gap: var(--home-content-gap);
    }

    .trust-download__lead {
      display: grid;
      justify-items: center;
      gap: 1rem;
      padding: clamp(1.5rem, 5vw, 5rem) clamp(1rem, 4vw, 4rem);
      border: 1px solid var(--line-default);
      border-radius: var(--radius-md);
      background: var(--color-surface-stage);
      text-align: center;
    }

    .trust-download h2 {
      margin: 0;
      font-size: var(--home-heading);
      line-height: var(--leading-heading);
    }

    .trust-download__destination {
      margin: 0;
      color: var(--color-text-secondary);
      font-size: var(--type-small);
      line-height: 1.5;
    }

    .trust-download__button {
      min-block-size: 3rem;
      padding-inline: 1.25rem;
      border-radius: var(--radius-sm);
    }

    .trust-download__details {
      display: grid;
      gap: var(--home-content-gap);
      inline-size: min(100%, 66rem);
      margin-inline: auto;
      padding-block: 1rem;
      border-block: 1px solid var(--line-faint);
      color: var(--color-text-secondary);
      line-height: 1.6;
    }

    .trust-download__details > div {
      display: grid;
      align-content: start;
      gap: var(--space-3);
      max-inline-size: 72ch;
    }

    @media (min-width: 64rem) {
      .trust-download__details {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    .trust-download__details p {
      margin: 0;
    }

    .trust-download__safety a {
      margin-inline-start: 0.35rem;
      color: var(--color-text-primary);
      text-decoration: underline;
      text-decoration-color: var(--line-default);
      text-underline-offset: 0.2em;
    }

    .trust-download__support {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.5rem 1.25rem;
      padding-block-start: 0.25rem;
      font-size: var(--type-small);
    }

    .trust-download__support span {
      color: var(--color-text-tertiary);
    }

    .trust-download__support a {
      color: var(--color-text-secondary);
      text-decoration: underline;
      text-decoration-color: var(--line-default);
      text-underline-offset: 0.2em;
    }

    .trust-download__support a:hover,
    .trust-download__safety a:hover {
      color: var(--color-action);
    }
  }
</style>
