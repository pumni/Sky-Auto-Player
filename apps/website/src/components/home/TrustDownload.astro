---
import type { HomeContent } from '../../data/home.types';
import { SITE } from '../../data/site';
import { withBase } from '../../utils/urls';

interface Props {
  data: HomeContent['trust'];
  locale: 'en' | 'vi';
}

const { data, locale } = Astro.props;
const safetyUrl = withBase(locale === 'vi' ? '/vi/faq/#account-safety' : '/faq/#account-safety');
---

<section
  id="technical"
  class="trust-download"
  aria-labelledby="trust-download-title"
  data-home-section="trust-download"
>
  <div class="container trust-download__layout">
    <div class="trust-download__panel">
      <div class="trust-download__release">
        <svg
          class="trust-download__release-icon"
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.65"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="3" width="18" height="13" rx="2" />
          <path d="M8 21h8m-4-5v5m0-15v7m-3-3 3 3 3-3" />
        </svg>
        <h2 id="trust-download-title">{data.title}</h2>
        <p class="trust-download__platform">{data.platformSummary}</p>
        <div class="trust-download__cta-action">
          <a class="trust-download__button" href={SITE.stableReleaseUrl}>
            <span>{data.releaseLinkLabel}</span>
            <span aria-hidden="true">↗</span>
          </a>
          <p class="trust-download__destination">{data.releaseDestinationNote}</p>
        </div>
      </div>
      <div class="trust-download__installation">
        <h3>{data.installationTitle}</h3>
        <ul class="trust-download__detail-list">
          <li>
            {data.installerGuidance} <code>{data.installerSuffix}</code>.
          </li>
          <li>{data.signatureNote}</li>
          <li>{data.installScope}</li>
        </ul>
        <p class="trust-download__warning">{data.signingValue}</p>
      </div>
      <div class="trust-download__safety">
        <svg
          class="trust-download__safety-icon"
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.65"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 3 4 6v6c0 4 3 7 8 9 5-2 8-5 8-9V6l-8-3Zm0 5v4m0 3h.01" />
        </svg>
        <div class="trust-download__safety-content">
          <h3>{data.safetyTitle}</h3>
          <ul class="trust-download__detail-list">
            <li>{data.safetyNote}</li>
            <li>{data.safetyBoundary}</li>
          </ul>
          <div class="trust-download__safety-action">
            <p class="trust-download__warning">{data.safetyRisk}</p>
            <a class="trust-download__safety-link" href={safetyUrl}>
              <span>{data.safetyLink}</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
    <nav id="faq-preview" class="trust-download__support" aria-labelledby="home-help-title">
      <div class="trust-download__support-intro">
        <h3 id="home-help-title">{data.supportLabel}</h3>
        <p>{data.supportDescription}</p>
      </div>
      <ul class="trust-download__support-links" role="list">
        {data.supportLinks.map((link, index) => (
          <li>
            <a href={withBase(link.href)} aria-describedby={`home-help-description-${index}`}>
              <span class="trust-download__support-copy">
                <span class="trust-download__support-title">{link.label}</span>
                <span
                  class="trust-download__support-description"
                  id={`home-help-description-${index}`}
                >
                  {link.description}
                </span>
              </span>
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</section>

<style>
  @layer components {
    .trust-download {
      padding-block-end: clamp(3rem, 6vw, 6rem);
    }

    .trust-download__layout {
      display: grid;
      gap: clamp(2rem, 4vw, 3.5rem);
    }

    .trust-download__panel {
      display: grid;
      gap: clamp(1.5rem, 4vw, 3rem);
      padding: clamp(1.25rem, 4vw, 3rem);
      border: 1px solid var(--line-default);
      border-radius: var(--radius-md);
      background: var(--color-surface-quiet);
      min-inline-size: 0;
    }

    .trust-download__release,
    .trust-download__installation,
    .trust-download__safety-content {
      min-inline-size: 0;
    }

    .trust-download__release-icon {
      display: block;
      inline-size: 2rem;
      block-size: 2rem;
      margin-block-end: 1.25rem;
      color: var(--color-action);
    }

    .trust-download__release h2 {
      margin: 0;
      max-inline-size: 17ch;
      font-size: var(--home-heading);
      line-height: 1.12;
      letter-spacing: -0.045em;
    }

    .trust-download__platform {
      max-inline-size: 38ch;
      margin: 0.875rem 0 0;
      color: var(--color-text-secondary);
      font-size: 0.9375rem;
      line-height: 1.6;
    }

    .trust-download__cta-action {
      display: grid;
      justify-items: start;
      gap: 0.5rem;
      margin-block-start: 1.5rem;
    }

    .trust-download__button {
      display: inline-flex;
      min-block-size: 48px;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.625rem 0.875rem;
      border: 1px solid var(--color-interactive-border);
      border-radius: var(--radius-sm);
      color: var(--color-action);
      font-size: 0.9375rem;
      font-weight: 600;
      line-height: 1.4;
      transition:
        border-color var(--duration-fast) var(--ease-standard),
        background-color var(--duration-fast) var(--ease-standard);
    }

    .trust-download__button:hover {
      border-color: var(--color-action);
      background: var(--color-surface-instrument);
      color: var(--color-action-hover);
    }

    .trust-download__destination {
      margin: 0;
      color: var(--color-text-secondary);
      font-size: 0.8125rem;
    }

    .trust-download__installation {
      padding-block-start: 1.5rem;
      border-block-start: 1px solid var(--line-default);
    }

    .trust-download__installation h3,
    .trust-download__safety h3,
    .trust-download__support h3 {
      margin: 0 0 0.75rem;
      font-size: 1.25rem;
      line-height: 1.35;
      letter-spacing: -0.02em;
    }

    .trust-download__detail-list {
      display: grid;
      gap: 0.5rem;
      max-inline-size: 64ch;
      margin: 0;
      padding-inline-start: 1.125rem;
      color: var(--color-text-secondary);
      font-size: 1rem;
      line-height: 1.65;
      list-style: disc;
    }

    .trust-download__detail-list li::marker {
      color: var(--color-text-tertiary);
    }

    .trust-download code {
      overflow-wrap: anywhere;
      color: var(--color-text-primary);
      font-size: 0.95em;
    }

    .trust-download__warning {
      max-inline-size: 64ch;
      margin: 1rem 0 0;
      padding-inline-start: 0.875rem;
      border-inline-start: 2px solid var(--color-action);
      color: var(--color-text-primary);
      font-size: 0.9375rem;
      line-height: 1.65;
    }

    .trust-download__safety {
      display: grid;
      grid-template-columns: 1.5rem minmax(0, 1fr);
      gap: 0.875rem;
      padding-block-start: clamp(1.5rem, 3vw, 2rem);
      border-block-start: 1px solid var(--line-default);
    }

    .trust-download__safety-icon {
      inline-size: 1.5rem;
      block-size: 1.5rem;
      color: var(--color-action);
    }

    .trust-download__safety-link {
      display: inline-flex;
      align-items: center;
      gap: 0.625rem;
      min-block-size: 44px;
      margin-block-start: 0.5rem;
      color: var(--color-action);
      font-size: 0.9375rem;
      font-weight: 600;
      line-height: 1.4;
    }

    .trust-download__safety-link > span:first-child {
      text-decoration: underline;
      text-underline-offset: 0.25em;
    }

    .trust-download__safety-link:hover {
      color: var(--color-action-hover);
    }

    .trust-download__support {
      display: grid;
      gap: 1rem;
      align-items: start;
    }

    .trust-download__support-intro p {
      max-inline-size: 42ch;
      margin: 0;
      color: var(--color-text-secondary);
      font-size: 0.9375rem;
      line-height: 1.65;
    }

    .trust-download__support-links {
      display: grid;
      gap: 0.25rem;
      padding: 0;
      margin: 0;
      list-style: none;
      border-block-start: 1px solid var(--line-default);
    }

    .trust-download__support-links li {
      min-inline-size: 0;
      border-block-end: 1px solid var(--line-default);
    }

    .trust-download__support-links a {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 1rem;
      min-block-size: 44px;
      padding-block: 0.875rem;
      color: var(--color-text-primary);
      transition: color var(--duration-fast) var(--ease-standard);
    }

    .trust-download__support-copy {
      display: grid;
      gap: 0.25rem;
    }

    .trust-download__support-title {
      font-weight: 600;
      font-size: 1rem;
      line-height: 1.4;
    }

    .trust-download__support-description {
      color: var(--color-text-secondary);
      font-size: 0.875rem;
      line-height: 1.6;
    }

    .trust-download__support-links a:hover,
    .trust-download__support-links a:focus-visible {
      color: var(--color-action);
    }

    .trust-download__support-links a:hover .trust-download__support-title,
    .trust-download__support-links a:focus-visible .trust-download__support-title {
      text-decoration: underline;
      text-underline-offset: 0.25em;
    }

    @media (min-width: 48rem) {
      .trust-download__panel {
        grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      }

      .trust-download__installation {
        padding-block-start: 0;
        padding-inline-start: clamp(1.5rem, 3vw, 2.5rem);
        border-block-start: 0;
        border-inline-start: 1px solid var(--line-default);
      }

      .trust-download__safety {
        grid-column: 1 / -1;
      }

      .trust-download__support {
        grid-template-columns: minmax(0, 0.65fr) minmax(0, 1.35fr);
        gap: var(--home-pair-gap);
      }
    }

    @media (min-width: 64rem) {
      .trust-download__safety-content {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
        column-gap: var(--home-pair-gap);
        align-items: start;
      }

      .trust-download__safety-content h3 {
        grid-column: 1 / -1;
      }

      .trust-download__safety-action .trust-download__warning {
        margin-block-start: 0;
      }
    }

    @media (forced-colors: active) {
      .trust-download__panel,
      .trust-download__installation,
      .trust-download__safety,
      .trust-download__support-links,
      .trust-download__support-links li,
      .trust-download__warning,
      .trust-download__button {
        border-color: CanvasText;
      }

      .trust-download__button,
      .trust-download__safety-link,
      .trust-download__support-links a {
        color: LinkText;
      }

      .trust-download__support-title {
        text-decoration: underline;
      }
    }
  }
</style>
