---
import type { HomeContent } from '../../data/home.types';
import { SITE } from '../../data/site';
import { withBase } from '../../utils/urls';

interface Props {
  data: HomeContent['trust'];
  locale: 'en' | 'vi';
}

const { data, locale } = Astro.props;
const safetyUrl = withBase(locale === 'vi' ? '/vi/faq/#account-safety' : '/faq/#account-safety');
---

<section
  id="technical"
  class="trust-download"
  aria-labelledby="trust-download-title"
  data-home-section="trust-download"
>
  <div class="container trust-download__layout">
    <div class="trust-download__cta">
      <div class="trust-download__cta-copy">
        <h2 id="trust-download-title">{data.title}</h2>
        <p class="trust-download__platform">{data.platformSummary}</p>
      </div>
      <div class="trust-download__cta-action">
        <a class="trust-download__button" href={SITE.stableReleaseUrl}>
          {data.releaseLinkLabel}
          <span aria-hidden="true">↗</span>
        </a>
        <p class="trust-download__destination">{data.releaseDestinationNote}</p>
      </div>
    </div>

    <div class="trust-download__details">
      <div>
        <h3>{data.installationTitle}</h3>
        <ul class="trust-download__install-list">
          <li>
            {data.installerGuidance} <code>{data.installerSuffix}</code>.
          </li>
          <li>{data.signatureNote}</li>
          <li>{data.installScope}</li>
        </ul>
        <p class="trust-download__warning">{data.signingValue}</p>
      </div>
      <div>
        <h3>{data.safetyTitle}</h3>
        <p>{data.safetyNote}</p>
        <a class="trust-download__safety-link" href={safetyUrl}>
          {data.safetyLink}
        </a>
      </div>
    </div>
    <nav id="faq-preview" class="trust-download__support" aria-label={data.supportLabel}>
      <span>{data.supportLabel}</span>
      <ul class="trust-download__support-links">
        {data.supportLinks.map((link) => (
          <li>
            <a href={withBase(link.href)}>
              {link.label}
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</section>

<style>
  @layer components {
    .trust-download {
      padding-block-end: var(--home-band-space);
    }
    .trust-download__layout {
      display: grid;
      gap: 2rem;
    }
    .trust-download__cta {
      display: grid;
      align-items: center;
      gap: 1rem;
      padding-block: 1.875rem;
      border-block: 1px solid var(--line-default);
    }
    .trust-download__cta h2 {
      margin: 0;
      font-size: clamp(1.8125rem, 3vw, 2.625rem);
      line-height: 1.12;
      letter-spacing: -0.045em;
    }
    .trust-download__platform {
      margin: 0.5rem 0 0;
      color: var(--color-text-secondary);
      font-size: 0.9375rem;
    }
    .trust-download__cta-action {
      display: grid;
      justify-items: start;
    }
    .trust-download__button,
    .trust-download__safety-link,
    .trust-download__support-links a {
      display: inline-flex;
      align-items: center;
      gap: 0.5625rem;
      min-block-size: 44px;
      color: var(--color-text-primary);
      font-weight: 600;
      text-decoration: underline;
      text-decoration-color: var(--color-info);
      text-underline-offset: 0.25em;
      font-size: 0.9375rem;
    }
    .trust-download__safety-link:hover,
    .trust-download__support-links a:hover {
      color: var(--color-action);
    }
    .trust-download__destination {
      margin: 0;
      color: var(--color-text-secondary);
      font-size: 0.8125rem;
    }
    .trust-download__details {
      display: grid;
      gap: var(--home-pair-gap);
      color: var(--color-text-secondary);
      font-size: 1rem;
      line-height: 1.65;
    }
    .trust-download__details > div {
      min-inline-size: 0;
    }
    .trust-download__details h3 {
      margin: 0 0 0.75rem;
      color: var(--color-text-primary);
      font-size: 1.25rem;
      line-height: 1.35;
    }
    .trust-download__install-list {
      display: grid;
      gap: 0.5rem;
      max-inline-size: 56ch;
      margin: 0;
      padding-inline-start: 1.125rem;
      list-style: disc;
    }
    .trust-download__install-list li::marker {
      color: var(--color-text-tertiary);
    }
    .trust-download__button {
      color: var(--color-action);
    }
    .trust-download__button:hover {
      color: var(--color-action-hover);
    }
    .trust-download__details p {
      max-inline-size: 56ch;
      margin: 0.5rem 0 0;
    }
    .trust-download__details .trust-download__warning {
      margin-block-start: 1.25rem;
      padding-inline-start: 1rem;
      border-inline-start: 2px solid var(--color-action);
    }
    .trust-download code {
      overflow-wrap: anywhere;
      color: var(--color-text-primary);
      font-size: 0.95em;
    }
    .trust-download__support {
      display: grid;
      align-items: start;
      gap: 0.5rem;
      padding-block-start: 1.375rem;
      border-block-start: 1px solid var(--line-default);
    }
    .trust-download__support > span {
      color: var(--color-text-primary);
      font-size: 1.125rem;
      font-weight: 600;
      min-block-size: 44px;
      display: flex;
      align-items: center;
    }
    .trust-download__support-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 1.5rem;
      padding: 0;
      margin: 0;
      list-style: none;
    }
    @media (min-width: 48rem) {
      .trust-download__cta {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--home-pair-gap);
      }
      .trust-download__cta-action {
        justify-self: start;
      }
      .trust-download__details,
      .trust-download__support {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        column-gap: var(--home-pair-gap);
      }
    }
    @media (forced-colors: active) {
      .trust-download__cta,
      .trust-download__support,
      .trust-download__warning {
        border-color: CanvasText;
      }
    }
  }
</style>
