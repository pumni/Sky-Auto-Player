---
import type { HomeContent } from '../../data/home.types';
import { SITE } from '../../data/site';
import { withBase } from '../../utils/urls';

interface Props {
  data: HomeContent['trust'];
  locale: 'en' | 'vi';
}

const { data, locale } = Astro.props;
const safetyUrl = withBase(locale === 'vi' ? '/vi/faq/#account-safety' : '/faq/#account-safety');
---

<section
  id="technical"
  class="trust-download"
  aria-labelledby="trust-download-title"
  data-home-section="trust-download"
>
  <div class="container trust-download__layout">
    <div class="trust-download__cta">
      <div class="trust-download__cta-copy">
        <h2 id="trust-download-title">{data.title}</h2>
        <p class="trust-download__platform">{data.platformSummary}</p>
      </div>
      <div class="trust-download__cta-action">
        <a class="button button--secondary trust-download__button" href={SITE.stableReleaseUrl}>
          {data.releaseLinkLabel}
          <span aria-hidden="true">↗</span>
        </a>
        <p class="trust-download__destination">{data.releaseDestinationNote}</p>
      </div>
    </div>

    <div class="trust-download__details">
      <div>
        <h3>{data.installationTitle}</h3>
        <p>
          {data.installerGuidance} <code>{data.installerSuffix}</code>.
        </p>
        <p>{data.signatureNote}</p>
        <p>{data.installScope}</p>
        <p class="trust-download__warning">{data.signingValue}</p>
      </div>
      <div>
        <h3>{data.safetyTitle}</h3>
        <p>{data.safetyNote}</p>
        <a class="trust-download__safety-link" href={safetyUrl}>
          {data.safetyLink}
        </a>
      </div>
    </div>
    <nav id="faq-preview" class="trust-download__support" aria-label={data.supportLabel}>
      <span>{data.supportLabel}</span>
      <ul class="trust-download__support-links">
        {data.supportLinks.map((link) => (
          <li><a href={withBase(link.href)}>{link.label}<span aria-hidden="true">→</span></a></li>
        ))}
      </ul>
    </nav>
  </div>
</section>

<style>
  @layer components {
    .trust-download {
      padding-block-end: var(--home-band-space);
    }
    .trust-download__layout {
      display: grid;
      border: 1px solid var(--line-default);
      border-radius: 0.9rem;
      background: var(--color-surface-quiet);
    }
    .trust-download__cta {
      display: grid;
      justify-items: center;
      gap: 1.5rem;
      padding: clamp(1.5rem, 4.5vw, 3.5rem);
      border-radius: 0.875rem 0.875rem 0 0;
      background: var(--color-surface-instrument);
      text-align: center;
    }
    .trust-download__cta-copy,
    .trust-download__cta-action {
      display: grid;
      justify-items: center;
      gap: 0.75rem;
    }
    .trust-download__cta h2 {
      margin: 0;
      font-size: clamp(2rem, 1.4rem + 2.1vw, 3.5rem);
      line-height: 1.12;
    }
    .trust-download__platform {
      margin: 0;
      color: var(--color-text-secondary);
      font-size: var(--home-lead);
      line-height: 1.6;
    }
    .trust-download__cta-action {
      gap: 0.625rem;
    }
    .trust-download__button {
      min-block-size: 3.25rem;
      padding-inline: 1.5rem;
      gap: 0.625rem;
      background: var(--color-surface-quiet);
    }
    .trust-download__destination {
      margin: 0;
      color: var(--color-text-secondary);
      font-size: var(--type-small);
      line-height: 1.5;
    }
    .trust-download__details {
      display: grid;
      gap: 2rem;
      padding: clamp(1.5rem, 4vw, 3.5rem);
      border-block-start: 1px solid var(--line-default);
      color: var(--color-text-secondary);
      font-size: var(--type-body);
      line-height: 1.7;
    }
    .trust-download__details > div {
      display: grid;
      align-content: start;
      gap: 1rem;
      min-inline-size: 0;
    }
    .trust-download__details h3 {
      margin: 0;
      color: var(--color-text-primary);
      font-size: clamp(1.25rem, 1rem + 0.5vw, 1.6rem);
      line-height: 1.35;
    }
    .trust-download__details p {
      margin: 0;
    }
    .trust-download__warning {
      padding: 1rem;
      border-inline-start: 2px solid var(--color-action);
      background: var(--color-surface-instrument);
      border-radius: var(--radius-xs);
    }
    .trust-download code {
      overflow-wrap: anywhere;
      color: var(--color-text-primary);
      font-size: 0.95em;
    }
    .trust-download__safety-link,
    .trust-download__support-links a {
      display: inline-flex;
      min-block-size: 2.75rem;
      align-items: center;
      color: var(--color-text-primary);
      text-decoration: underline;
      text-decoration-color: var(--color-info);
      text-underline-offset: 0.2em;
    }
    .trust-download__safety-link {
      justify-self: start;
    }
    .trust-download__support {
      display: grid;
      gap: 0.75rem;
      border-block-start: 1px solid var(--line-default);
      font-size: var(--type-body);
      padding: 1.5rem clamp(1.5rem, 4vw, 3.5rem);
    }
    .trust-download__support > span {
      color: var(--color-text-primary);
      font-weight: 600;
    }
    .trust-download__support-links {
      display: grid;
      gap: 0.5rem;
      padding: 0;
      margin: 0;
      list-style: none;
    }
    .trust-download__support-links a {
      display: flex;
      justify-content: space-between;
      block-size: 100%;
      gap: 1rem;
      padding: 0.625rem 0.875rem;
      border: 1px solid var(--line-default);
      border-radius: var(--radius-sm);
      text-decoration: none;
      background: var(--color-surface-instrument);
    }

    .trust-download__support-links a:hover,
    .trust-download__safety-link:hover {
      color: var(--color-action);
    }
    @media (min-width: 48rem) {
      .trust-download__cta {
        grid-template-columns: minmax(0, 1fr) auto;
        justify-items: stretch;
        align-items: center;
        gap: 2rem;
        text-align: start;
      }
      .trust-download__cta-copy {
        justify-items: start;
      }
      .trust-download__cta-action {
        justify-self: end;
      }
      .trust-download__support {
        grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
        align-items: center;
        gap: 2rem;
      }

      .trust-download__support-links {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.75rem;
      }

      .trust-download__details {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: clamp(2rem, 5vw, 4rem);
      }
    }
    @media (forced-colors: active) {
      .trust-download__cta {
        background: Canvas;
      }
      .trust-download__layout,
      .trust-download__details,
      .trust-download__support,
      .trust-download__support-links a {
        border-color: CanvasText;
      }
    }
  }
</style>
