---
import type { HomeContent } from '../../data/home.types';
import { PRODUCT_RELEASE } from '../../data/product-release';
import { SITE } from '../../data/site';
import { withBase } from '../../utils/urls';
import SectionIntro from '../ui/SectionIntro.astro';

interface Props {
  data: HomeContent['trust'];
  locale: 'en' | 'vi';
}

const { data, locale } = Astro.props;
const safetyUrl = withBase(locale === 'vi' ? '/vi/faq/#account-safety' : '/faq/#account-safety');
---

<section
  id="technical"
  class="trust-download section-shell section-shell--product section-shell--bordered"
  aria-labelledby="trust-download-title"
  data-home-section="trust-download"
>
  <div class="container trust-download__layout">
    <div class="trust-download__intro">
      <SectionIntro
        kicker={data.kicker}
        title={data.title}
        description={data.description}
        titleId="trust-download-title"
      />
      <a class="button button--primary trust-download__button" href={SITE.releaseUrl}>
        <span>{data.downloadLabel}</span>
        <span class="trust-download__destination">{data.downloadDestination}</span>
      </a>
      <a class="trust-download__source" href={SITE.repositoryUrl}>
        {data.sourceLabel}
        <span aria-hidden="true"> ↗</span>
      </a>
    </div>

    <dl class="release-details">
      <div class="release-details__row">
        <dt>{data.releaseLabel}</dt>
        <dd>
          {data.releaseValue}
          {PRODUCT_RELEASE.version}
        </dd>
      </div>
      <div class="release-details__row">
        <dt>{data.packageLabel}</dt>
        <dd>{data.packageValue}</dd>
      </div>
      <div class="release-details__row">
        <dt>{data.signingLabel}</dt>
        <dd>{data.signingValue}</dd>
      </div>
      <div class="release-details__row">
        <dt>{data.updaterLabel}</dt>
        <dd>{data.updaterValue}</dd>
      </div>
    </dl>

    <aside
      class="trust-download__safety"
      aria-label={locale === 'vi' ? 'Ranh giới an toàn' : 'Safety boundaries'}
    >
      <p>{data.safetyNote}</p>
      <a href={safetyUrl}>
        {data.safetyLink}
        <span aria-hidden="true"> →</span>
      </a>
    </aside>
  </div>
</section>

<style>
  @layer components {
    .trust-download {
      background:
        linear-gradient(
          90deg,
          transparent 0%,
          color-mix(in oklch, var(--color-action) 3%, transparent) 100%
        ),
        var(--color-page);
    }

    .trust-download__layout {
      display: grid;
      gap: var(--space-7);
    }

    .trust-download__button {
      display: inline-flex;
      min-block-size: 3.75rem;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 0.125rem;
      margin-block-start: var(--space-4);
      padding-block: var(--space-2);
    }

    .trust-download__destination {
      color: color-mix(in oklch, var(--color-text-on-action) 78%, transparent);
      font-size: var(--type-micro);
      font-weight: 500;
      line-height: 1.2;
    }

    .trust-download__source {
      display: block;
      inline-size: fit-content;
      min-block-size: 44px;
      align-content: center;
      margin-block-start: var(--space-2);
      color: var(--color-text-secondary);
      font-size: var(--type-small);
      text-decoration: underline;
      text-decoration-color: var(--line-default);
      text-underline-offset: 0.2em;
    }

    .release-details {
      margin: 0;
      border-block-start: 1px solid var(--line-default);
    }

    .release-details__row {
      display: grid;
      gap: var(--space-2);
      padding-block: var(--space-4);
      border-block-end: 1px solid var(--line-faint);
    }

    .release-details dt {
      color: var(--color-text-tertiary);
      font-family: var(--font-mono);
      font-size: var(--type-micro);
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    :lang(vi) .release-details dt {
      letter-spacing: 0;
      text-transform: none;
    }

    .release-details dd {
      margin: 0;
      color: var(--color-text-secondary);
      font-size: var(--type-small);
    }

    .trust-download__safety {
      max-inline-size: 72ch;
      padding-inline-start: var(--space-4);
      border-inline-start: 2px solid var(--color-warning);
      color: var(--color-text-tertiary);
      font-size: var(--type-small);
    }

    .trust-download__safety p {
      margin-block-end: var(--space-2);
    }

    .trust-download__safety a {
      display: inline-flex;
      min-block-size: 44px;
      align-items: center;
      color: var(--color-text-primary);
      font-weight: 650;
      text-decoration: underline;
      text-decoration-color: var(--line-accent);
      text-underline-offset: 0.2em;
    }

    @media (min-width: 64rem) {
      .trust-download__layout {
        grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        gap: var(--grid-gap) var(--space-8);
        align-items: start;
      }

      .trust-download__safety {
        grid-column: 1 / -1;
      }
    }
  }
</style>
