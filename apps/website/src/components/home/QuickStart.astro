---
import type { HomeContent } from '../../data/home.types';
import { withBase } from '../../utils/urls';

interface Props {
  data: HomeContent['quickStart'];
}

const { data } = Astro.props;
---

<section
  id="how-it-works"
  class="quick-start"
  aria-labelledby="quick-start-title"
  data-home-section="quick-start"
>
  <div class="container quick-start__layout">
    <h2 id="quick-start-title">{data.title}</h2>
    <ol class="quick-start__steps">
      {data.items.map((item, index) => (
        <li class="quick-start__step">
          <span class="quick-start__number" aria-hidden="true">
            0{index + 1}
          </span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        </li>
      ))}
    </ol>
    <div class="quick-start__resources">
      <a class="quick-start__setup" href={withBase(data.setupGuideHref)}>
        {data.setupGuideLabel}
      </a>
      <p class="quick-start__formats" id="formats">
        <strong>{data.formatsLabel}</strong>
        <span>{data.formatsValue}</span>
        <a href={withBase(data.formatsHref)}>{data.formatsLinkLabel}</a>
      </p>
    </div>
  </div>
</section>

<style>
  @layer components {
    .quick-start__layout {
      display: grid;
      gap: var(--home-content-gap);
    }

    .quick-start h2 {
      max-inline-size: 24ch;
      margin: 0;
      font-size: var(--home-heading);
      line-height: var(--leading-heading);
    }

    .quick-start__steps {
      display: grid;
      gap: 2rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .quick-start__step {
      display: grid;
      grid-template-columns: 2.5rem minmax(0, 1fr);
      gap: 1.25rem;
      padding-block-start: 1.5rem;
      border-block-start: 1px solid var(--line-default);
    }

    @media (max-width: 40rem) {
      .quick-start__step {
        grid-template-columns: 2rem minmax(0, 1fr);
      }
    }

    .quick-start__number {
      color: var(--color-action);
      font-family: var(--font-display);
      font-size: clamp(1.75rem, 1.3rem + 1vw, 2.5rem);
      line-height: 1.2;
      font-variant-numeric: tabular-nums;
    }

    .quick-start__step h3 {
      margin: 0 0 0.875rem;
      font-size: clamp(1.25rem, 1rem + 0.5vw, 1.5rem);
      line-height: 1.35;
    }

    .quick-start__step p {
      max-inline-size: 42ch;
      margin: 0;
      color: var(--color-text-secondary);
      font-size: var(--type-body);
      line-height: 1.75;
    }

    .quick-start__resources {
      display: grid;
      gap: 1.5rem;
      padding-block-start: clamp(1.5rem, 3vw, 2.5rem);
      border-block-start: 1px solid var(--line-faint);
    }

    .quick-start__formats a {
      color: var(--color-action);
      text-decoration: underline;
      text-decoration-color: var(--line-accent);
      text-underline-offset: 0.22em;
    }

    .quick-start__formats a {
      display: inline-flex;
      min-block-size: 2.75rem;
      align-items: center;
      font-size: var(--type-small);
    }

    .quick-start__setup {
      display: inline-flex;
      min-block-size: 2.75rem;
      align-items: center;
      justify-self: start;
      font-weight: 600;
      padding: 0.625rem 1rem;
      border: 1px solid var(--color-interactive-border);
      border-radius: var(--radius-sm);
      color: var(--color-text-primary);
      text-decoration: none;
      align-self: start;
    }

    .quick-start__setup:hover {
      border-color: var(--color-action);
      color: var(--color-action);
    }

    .quick-start__formats {
      display: grid;


      gap: 0.5rem;
      margin: 0;


      color: var(--color-text-secondary);
      font-size: var(--type-body);
      line-height: 1.6;
      justify-items: start;
    }

    .quick-start__formats strong {
      color: var(--color-text-primary);
      font-weight: 650;
    }

    @media (min-width: 48rem) {
      .quick-start__steps {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        align-items: start;
        gap: clamp(1.5rem, 4vw, 4rem);
      }

      .quick-start__step {
        grid-template-columns: minmax(0, 1fr);
        gap: 1.25rem;
        align-content: start;


      }

      .quick-start__number {
        min-block-size: 2.75rem;
        font-size: clamp(2rem, 1.5rem + 1.2vw, 2.75rem);
        line-height: 1;
      }

      .quick-start__resources {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 2.5rem;
        align-items: start;
      }
    }
  }
</style>
