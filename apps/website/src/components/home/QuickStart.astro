---
import type { HomeContent } from '../../data/home.types';
import { withBase } from '../../utils/urls';

interface Props {
  data: HomeContent['quickStart'];
}

const { data } = Astro.props;
---

<section
  id="how-it-works"
  class="quick-start"
  aria-labelledby="quick-start-title"
  data-home-section="quick-start"
>
  <div class="container quick-start__layout">
    <h2 id="quick-start-title">{data.title}</h2>
    <ol class="quick-start__steps">
      {data.items.map((item, index) => (
        <li class="quick-start__step">
          <span class="quick-start__number" aria-hidden="true">
            0{index + 1}
          </span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        </li>
      ))}
    </ol>
    <div class="quick-start__resources">
      <div class="quick-start__setup">
        <h3>{data.setupGuideTitle}</h3>
        <div class="quick-start__resource-body">
          <p>{data.setupGuideDescription}</p>
        </div>
        <a class="quick-start__resource-link" href={withBase(data.setupGuideHref)}>
          {data.setupGuideLabel}<span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="quick-start__formats" id="formats">
        <h3>{data.formatsLabel}</h3>
        <div class="quick-start__resource-body">
          <ul class="quick-start__format-list" aria-label={data.formatsLabel}>
            {data.formats.map((format) => (
              <li><code>{format}</code></li>
            ))}
          </ul>
          <p>{data.formatsNote}</p>
        </div>
        <a class="quick-start__resource-link" href={withBase(data.formatsHref)}>
          {data.formatsLinkLabel}<span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  @layer components {
    .quick-start {
      padding-block: var(--home-band-space);
    }
    .quick-start__layout {
      display: grid;
      gap: var(--home-content-gap);
    }
    .quick-start h2 {
      max-inline-size: 22ch;
      margin: 0;
      font-size: var(--home-heading);
      line-height: 1.12;
    }
    .quick-start__steps {
      display: grid;
      margin: 0;
      padding: 0;
      list-style: none;
      border: 1px solid var(--line-default);
      border-radius: 0.875rem;
    }
    .quick-start__step {
      display: grid;
      grid-template-columns: 2.5rem minmax(0, 1fr);
      gap: 1rem;
      padding: clamp(1.25rem, 3vw, 2.5rem);
    }
    .quick-start__step + .quick-start__step {
      border-block-start: 1px solid var(--line-default);
    }
    .quick-start__number {
      display: grid;
      place-items: center;
      inline-size: 2.5rem;
      block-size: 2.5rem;
      border: 1px solid var(--line-default);
      border-radius: 50%;
      background: var(--color-surface-instrument);
      color: var(--color-text-primary);
      font-size: 0.95rem;
      font-weight: 600;
      font-variant-numeric: tabular-nums;
      line-height: 1;
    }
    .quick-start__step h3 {
      margin: 0.25rem 0 0.75rem;
      font-size: clamp(1.15rem, 1rem + 0.4vw, 1.5rem);
      line-height: 1.35;
    }
    .quick-start__step p {
      max-inline-size: 42ch;
      margin: 0;
      color: var(--color-text-secondary);
      font-size: var(--type-body);
      line-height: 1.7;
    }
    .quick-start__resources {
      display: grid;
      gap: 1.5rem;
      align-items: stretch;
    }

    .quick-start__resources > div {
      display: grid;
      grid-template-rows: auto 1fr auto;
      justify-items: start;
      gap: 0.75rem;
      min-inline-size: 0;
      padding: clamp(1.25rem, 2.5vw, 2rem);
      border: 1px solid var(--line-default);
      border-radius: 0.875rem;
      background: var(--color-surface-quiet);
    }

    .quick-start__resources h3 {
      margin: 0;
      font-size: var(--type-h3);
      line-height: 1.35;
    }

    .quick-start__resource-body {
      display: grid;
      align-content: start;
      gap: 0.75rem;
    }

    .quick-start__resources p {
      margin: 0;
      color: var(--color-text-secondary);
      line-height: 1.65;
    }

    .quick-start__resource-link {
      display: inline-flex;
      min-block-size: 44px;
      align-items: center;
      gap: 0.625rem;
      color: var(--color-text-primary);
      font-weight: 600;
      text-decoration: underline;
      text-decoration-color: var(--color-info);
      text-underline-offset: 0.25em;
    }

    .quick-start__resource-link:hover {
      color: var(--color-action);
      text-decoration-color: currentColor;
    }

    .quick-start__format-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .quick-start__format-list code {
      display: block;
      padding: 0.4rem 0.65rem;
      border: 1px solid var(--line-default);
      border-radius: var(--radius-xs);
      background: var(--color-surface-instrument);
      color: var(--color-text-primary);
      font-family: var(--font-mono);
      font-size: var(--type-small);
    }

    @media (min-width: 48rem) {
      .quick-start__steps {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
      .quick-start__step {
        grid-template-columns: minmax(0, 1fr);
        align-content: start;
        gap: 1.5rem;
      }
      .quick-start__step + .quick-start__step {
        border-block-start: 0;
        border-inline-start: 1px solid var(--line-default);
      }
      .quick-start__resources {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.5rem;
      }
    }
    @media (forced-colors: active) {
      .quick-start__steps,
      .quick-start__step + .quick-start__step,
      .quick-start__number,
      .quick-start__resources > div,
      .quick-start__format-list code {
        border-color: CanvasText;
      }
    }
  }
</style>
