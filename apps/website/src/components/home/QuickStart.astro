---
import type { HomeContent } from '../../data/home.types';
import { withBase } from '../../utils/urls';
import SectionIntro from '../ui/SectionIntro.astro';

interface Props {
  data: HomeContent['quickStart'];
}

const { data } = Astro.props;
---

<section
  id="how-it-works"
  class="quick-start section-shell section-shell--feature"
  aria-labelledby="quick-start-title"
  data-home-section="quick-start"
>
  <div class="container quick-start__layout">
    <SectionIntro kicker={data.kicker} title={data.title} titleId="quick-start-title" />
    <ol class="quick-start__steps">
      {data.items.map((item, index) => (
        <li class="quick-start__step">
          <span class="quick-start__number" aria-hidden="true">
            0{index + 1}
          </span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <a class="quick-start__link" href={withBase(item.href)}>
              {item.linkLabel}
              <span aria-hidden="true"> ↗</span>
            </a>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  @layer components {
    .quick-start__layout {
      display: grid;
      gap: var(--space-7);
    }

    .quick-start__steps {
      display: grid;
      gap: 0;
      margin: 0;
      padding: 0;
      border-block-start: 1px solid var(--line-default);
      list-style: none;
      counter-reset: quick-start;
    }

    .quick-start__step {
      display: grid;
      grid-template-columns: 2.5rem minmax(0, 1fr);
      gap: var(--space-4);
      padding-block: var(--space-5);
      border-block-end: 1px solid var(--line-faint);
      counter-increment: quick-start;
    }

    .quick-start__number {
      padding-block-start: 0.2rem;
      color: var(--color-action);
      font-family: var(--font-mono);
      font-size: var(--type-small);
    }

    .quick-start__step h3 {
      margin-block-end: var(--space-2);
    }

    .quick-start__step p {
      max-inline-size: 62ch;
      margin-block-end: var(--space-3);
      color: var(--color-text-secondary);
      font-size: var(--type-small);
    }

    .quick-start__link {
      display: inline-flex;
      min-block-size: 44px;
      align-items: center;
      color: var(--color-action);
      font-size: var(--type-small);
      font-weight: 650;
      text-decoration: underline;
      text-decoration-color: var(--line-accent);
      text-underline-offset: 0.24em;
    }

    @media (min-width: 64rem) {
      .quick-start__layout {
        grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
        gap: var(--grid-gap);
        align-items: start;
      }

      .quick-start__step {
        grid-template-columns: 3rem minmax(0, 1fr);
        gap: var(--space-5);
        padding-block: var(--space-6);
      }

      .quick-start__number {
        font-size: var(--type-label);
      }
    }
  }
</style>
