---
import type { HomeContent } from '../../data/home.types';
import { withBase } from '../../utils/urls';

interface Props {
  data: HomeContent['quickStart'];
}

const { data } = Astro.props;
---

<section
  id="how-it-works"
  class="quick-start"
  aria-labelledby="quick-start-title"
  data-home-section="quick-start"
>
  <div class="container quick-start__layout">
    <h2 id="quick-start-title">{data.title}</h2>
    <ol class="quick-start__steps">
      {data.items.map((item, index) => (
        <li class="quick-start__step">
          <span class="quick-start__number" aria-hidden="true">
            0{index + 1}
          </span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        </li>
      ))}
    </ol>
    <div class="quick-start__resources">
      <a class="quick-start__setup" href={withBase(data.setupGuideHref)}>
        {data.setupGuideLabel}
      </a>
      <p class="quick-start__formats" id="formats">
        <strong>{data.formatsLabel}</strong>
        <span>{data.formatsValue}</span>
        <a href={withBase(data.formatsHref)}>{data.formatsLinkLabel}</a>
      </p>
    </div>
  </div>
</section>

<style>
  @layer components {
    .quick-start {
      padding-block: var(--home-band-space);
    }
    .quick-start__layout {
      display: grid;
      gap: var(--home-content-gap);
    }
    .quick-start h2 {
      max-inline-size: 22ch;
      margin: 0;
      font-size: var(--home-heading);
      line-height: 1.12;
    }
    .quick-start__steps {
      display: grid;
      margin: 0;
      padding: 0;
      list-style: none;
      border: 1px solid var(--line-default);
      border-radius: 1rem;
      background: var(--color-surface-quiet);
    }
    .quick-start__step {
      display: grid;
      grid-template-columns: 2.5rem minmax(0, 1fr);
      gap: 1rem;
      padding: clamp(1.25rem, 3vw, 2.5rem);
    }
    .quick-start__step + .quick-start__step {
      border-block-start: 1px solid var(--line-default);
    }
    .quick-start__number {
      display: grid;
      place-items: center;
      inline-size: 2.5rem;
      block-size: 2.5rem;
      border: 1px solid var(--line-accent);
      border-radius: 50%;
      background: var(--color-surface-active);
      color: var(--color-action);
      font-size: 0.95rem;
      font-weight: 600;
      font-variant-numeric: tabular-nums;
      line-height: 1;
    }
    .quick-start__step h3 {
      margin: 0.25rem 0 0.75rem;
      font-size: clamp(1.15rem, 1rem + 0.4vw, 1.5rem);
      line-height: 1.35;
    }
    .quick-start__step p {
      max-inline-size: 42ch;
      margin: 0;
      color: var(--color-text-secondary);
      font-size: var(--type-body);
      line-height: 1.7;
    }
    .quick-start__resources {
      display: grid;
      gap: 1.5rem;
      align-items: start;
    }
    .quick-start__setup {
      display: inline-flex;
      min-block-size: 2.75rem;
      align-items: center;
      justify-self: start;
      padding: 0.75rem 1.25rem;
      border: 1px solid var(--color-interactive-border);
      border-radius: 0.6rem;
      color: var(--color-text-primary);
      font-weight: 600;
      text-decoration: none;
    }
    .quick-start__setup:hover {
      border-color: var(--color-action);
      color: var(--color-action);
    }
    .quick-start__formats {
      display: grid;
      justify-items: start;
      gap: 0.375rem;
      margin: 0;
      color: var(--color-text-secondary);
      font-size: var(--type-body);
      line-height: 1.6;
    }
    .quick-start__formats strong {
      color: var(--color-text-primary);
      font-weight: 650;
    }
    .quick-start__formats a {
      display: inline-flex;
      min-block-size: 2.75rem;
      align-items: center;
      color: var(--color-action);
      font-size: var(--type-small);
      text-decoration: underline;
      text-decoration-color: var(--line-accent);
      text-underline-offset: 0.22em;
    }
    @media (min-width: 48rem) {
      .quick-start__steps {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
      .quick-start__step {
        grid-template-columns: minmax(0, 1fr);
        align-content: start;
        gap: 1.5rem;
      }
      .quick-start__step + .quick-start__step {
        border-block-start: 0;
        border-inline-start: 1px solid var(--line-default);
      }
      .quick-start__resources {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 3rem;
      }
    }
    @media (forced-colors: active) {
      .quick-start__steps,
      .quick-start__step + .quick-start__step,
      .quick-start__number {
        border-color: CanvasText;
      }
    }
  }
</style>
