---
import type { HomeContent } from '../../data/home.types';
import { withBase } from '../../utils/urls';

interface Props {
  data: HomeContent['quickStart'];
}

const { data } = Astro.props;
---

<section
  id="how-it-works"
  class="home-chapter quick-start"
  aria-labelledby="quick-start-title"
  data-home-section="quick-start"
>
  <div class="container quick-start__layout">
    <h2 id="quick-start-title">{data.title}</h2>
    <ol class="quick-start__steps">
      {data.items.map((item, index) => (
        <li class="quick-start__step">
          <span class="quick-start__number" aria-hidden="true">
            0{index + 1}
          </span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        </li>
      ))}
    </ol>
    <div class="quick-start__links">
      <a href={withBase(data.setupGuideHref)}>
        {data.setupGuideLabel}
        <span aria-hidden="true"> ↗</span>
      </a>
    </div>
    <p class="quick-start__formats" id="formats">
      <span>{data.formatsLabel}</span>
      <span>{data.formatsValue}</span>
      <a href={withBase(data.formatsHref)}>
        {data.formatsLinkLabel}
        <span aria-hidden="true"> ↗</span>
      </a>
    </p>
  </div>
</section>

<style>
  @layer components {
    .quick-start__layout {
      display: grid;
      gap: 1.5rem;
    }

    .quick-start h2 {
      max-inline-size: 24ch;
      margin: 0;
      font-size: var(--type-h2);
      line-height: var(--leading-heading);
    }

    .quick-start__steps {
      display: grid;
      gap: 1.25rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .quick-start__step {
      display: grid;
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: 0.875rem;
    }

    .quick-start__number {
      padding-block-start: 0.2rem;
      color: var(--color-info);
      font-size: var(--type-small);
      font-variant-numeric: tabular-nums;
    }

    .quick-start__step h3 {
      margin-block-end: 0.3rem;
      font-size: var(--type-body);
      line-height: 1.35;
    }

    .quick-start__step p {
      max-inline-size: 38ch;
      margin: 0;
      color: var(--color-text-secondary);
      font-size: var(--type-body);
      line-height: var(--leading-body);
    }

    .quick-start__links a,
    .quick-start__formats a {
      color: var(--color-action);
      text-decoration: underline;
      text-decoration-color: var(--line-accent);
      text-underline-offset: 0.22em;
    }

    .quick-start__formats {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.35rem 0.75rem;
      margin: 0;
      padding-block-start: 1rem;
      border-block-start: 1px solid var(--line-faint);
      color: var(--color-text-secondary);
      font-size: var(--type-small);
    }

    .quick-start__formats > span:first-child {
      color: var(--color-text-tertiary);
    }

    @media (min-width: 72rem) {
      .quick-start__steps {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 2rem;
      }

      .quick-start__step {
        grid-template-columns: 1.75rem minmax(0, 1fr);
        gap: 0.75rem;
      }

      .quick-start__formats {
        gap-inline: 1rem;
      }
    }
  }
</style>
