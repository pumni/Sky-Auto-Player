---
import type { HomeContent } from '../../data/home.types';
import { withBase } from '../../utils/urls';

interface Props {
  data: HomeContent['quickStart'];
}

const { data } = Astro.props;
---

<section
  id="how-it-works"
  class="quick-start"
  aria-labelledby="quick-start-title"
  data-home-section="quick-start"
>
  <div class="container quick-start__layout">
    <header class="quick-start__heading">
      <h2 id="quick-start-title">{data.title}</h2>
      <p>{data.description}</p>
    </header>
    <ol class="quick-start__steps">
      {data.items.map((item, index) => (
        <li class="quick-start__step">
          <span class="quick-start__number" aria-hidden="true">
            0{index + 1}
          </span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        </li>
      ))}
    </ol>
    <div class="quick-start__resources">
      <div class="quick-start__setup">
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.65"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 6C9 3 5 3 2 4v15c4-1 7-1 10 2 3-3 6-3 10-2V4c-3-1-7-1-10 2zm0 0v15" />
        </svg>
        <div class="quick-start__resource-content">
          <h3>{data.setupGuideTitle}</h3>
          <p>{data.setupGuideDescription}</p>
          <a class="quick-start__resource-link" href={withBase(data.setupGuideHref)}>
            <span>{data.setupGuideLabel}</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
      <div class="quick-start__formats" id="formats">
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.65"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 3h9l5 5v13H5zM14 3v5h5M10 12l-3 3 3 3m4-6 3 3-3 3" />
        </svg>
        <div class="quick-start__resource-content">
          <h3>{data.formatsLabel}</h3>
          <div class="quick-start__resource-body">
            <ul class="quick-start__format-list" aria-label={data.formatsLabel}>
              {data.formats.map((format) => (
                <li>
                  <code>{format}</code>
                </li>
              ))}
            </ul>
            <p>{data.formatsNote}</p>
          </div>
          <a class="quick-start__resource-link" href={withBase(data.formatsHref)}>
            <span>{data.formatsLinkLabel}</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @layer components {
    .quick-start {
      padding-block: var(--home-band-space) clamp(2.5rem, 4vw, 4rem);
    }
    .quick-start__layout {
      display: grid;
      gap: var(--home-content-gap);
    }
    .quick-start__heading h2 {
      margin: 0;
      font-size: var(--home-heading);
      line-height: 1.12;
      letter-spacing: -0.045em;
    }
    .quick-start__heading p {
      margin: 0.75rem 0 0;
      color: var(--color-text-secondary);
      font-size: 1.0625rem;
    }
    .quick-start__steps {
      display: grid;
      gap: 1.375rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .quick-start__step {
      display: grid;
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: 0.75rem;
      padding-block-start: 1.25rem;
      border-block-start: 1px solid var(--line-default);
    }
    .quick-start__number {
      color: var(--color-action);
      font: 600 0.9375rem/1.35 var(--font-mono);
      padding-block-start: 0.25rem;
    }
    .quick-start__step h3 {
      margin: 0 0 0.5rem;
      font-size: 1.25rem;
      line-height: 1.35;
    }
    .quick-start__step p {
      max-inline-size: 35ch;
      margin: 0;
      color: var(--color-text-secondary);
      font-size: 1rem;
      line-height: 1.65;
    }
    .quick-start__resources {
      display: grid;
      gap: 1.5rem;
      padding-block-start: 1.75rem;
      border-block-start: 1px solid var(--line-default);
    }
    .quick-start__resources > div {
      display: grid;
      grid-template-columns: 1.5rem minmax(0, 1fr);
      gap: 0.9375rem;
      min-inline-size: 0;
    }
    .quick-start__resources > div > svg {
      inline-size: 1.5rem;
      block-size: 1.5rem;
      color: var(--color-action);
    }
    .quick-start__resource-content {
      display: grid;
      align-content: start;
      gap: 0.5rem;
      min-inline-size: 0;
    }
    .quick-start__resources h3 {
      margin: 0;
      font-size: 1.1875rem;
      line-height: 1.35;
    }
    .quick-start__resource-body {
      display: grid;
      align-content: start;
      gap: 0.5rem;
    }
    .quick-start__resources p {
      margin: 0;
      color: var(--color-text-secondary);
      font-size: 0.9375rem;
      line-height: 1.65;
    }
    .quick-start__resource-link {
      display: inline-flex;
      min-block-size: 44px;
      align-items: center;
      justify-self: start;
      gap: 0.625rem;
      color: var(--color-text-primary);
      font-size: 0.9375rem;
      font-weight: 600;
      text-decoration: none;
    }
    .quick-start__resource-link > span:first-child {
      text-decoration: underline;
      text-decoration-color: var(--color-info);
      text-underline-offset: 0.25em;
    }
    .quick-start__resource-link:hover {
      color: var(--color-action);
    }
    .quick-start__format-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .quick-start__format-list code {
      display: block;
      padding: 0.3125rem 0.625rem;
      border: 1px solid var(--line-default);
      border-radius: 0.3125rem;
      background: var(--color-surface-quiet);
      color: var(--color-text-primary);
      font: 500 0.875rem/1.5 var(--font-mono);
    }
    @media (min-width: 48rem) {
      .quick-start__steps {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: clamp(1.75rem, 4vw, 3.75rem);
      }
      .quick-start__step {
        grid-template-columns: minmax(0, 1fr);
        align-content: start;
        padding-block-start: 1.5rem;
        gap: 1.25rem;
      }
      .quick-start__resources {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--home-pair-gap);
      }
    }
    @media (max-width: 47.99rem) {
      .quick-start__formats {
        padding-block-start: 1.5rem;
        border-block-start: 1px solid var(--line-default);
      }
    }
    @media (forced-colors: active) {
      .quick-start__resource-link {
        color: LinkText;
      }
      .quick-start__step,
      .quick-start__resources,
      .quick-start__formats,
      .quick-start__format-list code {
        border-color: CanvasText;
      }
    }
  }
</style>
