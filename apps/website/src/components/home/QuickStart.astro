---
import type { HomeContent } from '../../data/home.types';
import { withBase } from '../../utils/urls';

interface Props {
  data: HomeContent['quickStart'];
}

const { data } = Astro.props;
---

<section
  id="how-it-works"
  class="quick-start"
  aria-labelledby="quick-start-title"
  data-home-section="quick-start"
>
  <div class="container quick-start__layout">
    <header class="quick-start__heading">
      <p class="quick-start__eyebrow">{data.eyebrow}</p>
      <h2 id="quick-start-title">{data.title}</h2>
      <p class="quick-start__lead">{data.description}</p>
    </header>
    <ol class="quick-start__steps" role="list">
      {data.items.map((item, index) => (
        <li class="quick-start__step">
          <span class="quick-start__number" aria-hidden="true">0{index + 1}</span>
          <h3>{item.title}</h3>
          <div class="quick-start__step-content">
            <p>{item.description}</p>
            {index === 0 && (
              <a class="quick-start__resource-link" href={withBase(data.setupGuideHref)}>
                <span>{data.setupGuideLabel}</span>
                <span aria-hidden="true">→</span>
              </a>
            )}
            {index === 1 && (
              <div class="quick-start__formats" id="formats">
                <p class="quick-start__formats-label" id="formats-title">{data.formatsLabel}</p>
                <ul class="quick-start__format-list" aria-labelledby="formats-title" role="list">
                  {data.formats.map((format) => (
                    <li><code>{format}</code></li>
                  ))}
                </ul>
                <p class="quick-start__formats-note">{data.formatsNote}</p>
                <a class="quick-start__resource-link" href={withBase(data.formatsHref)}>
                  <span>{data.formatsLinkLabel}</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  @layer components {
    .quick-start {
      padding-block: var(--home-band-space) clamp(3rem, 5vw, 5rem);
    }

    .quick-start__layout {
      display: grid;
      gap: clamp(1.75rem, 4vw, 3rem);
    }

    .quick-start__heading {
      max-inline-size: 56rem;
    }

    .quick-start__eyebrow {
      margin: 0 0 0.875rem;
      color: var(--color-action);
      font-size: 0.875rem;
      font-weight: 600;
    }

    .quick-start__heading h2 {
      margin: 0;
      font-size: var(--home-heading);
      line-height: 1.12;
      letter-spacing: -0.045em;
    }

    .quick-start__lead {
      margin: 0.875rem 0 0;
      max-inline-size: 58ch;
      color: var(--color-text-secondary);
      font-size: var(--home-lead);
      line-height: 1.6;
    }

    .quick-start__steps {
      display: grid;
      margin: 0;
      padding: 0;
      list-style: none;
      border-block-start: 1px solid var(--line-default);
    }

    .quick-start__step {
      display: grid;
      grid-template-columns: 2.5rem minmax(0, 1fr);
      column-gap: 1rem;
      row-gap: 0.625rem;
      align-items: start;
      padding-block: clamp(1.5rem, 3vw, 2.25rem);
      border-block-end: 1px solid var(--line-default);
      min-inline-size: 0;
    }

    .quick-start__number {
      display: grid;
      place-items: center;
      inline-size: 2.5rem;
      block-size: 2.5rem;
      border-radius: 50%;
      border: 1px solid var(--color-interactive-border);
      color: var(--color-action);
      font: 600 0.875rem/1 var(--font-mono);
    }

    .quick-start__step h3 {
      margin: 0;
      align-self: center;
      font-size: clamp(1.25rem, 2vw, 1.5rem);
      line-height: 1.3;
      letter-spacing: -0.025em;
      text-wrap: pretty;
    }

    .quick-start__step-content {
      grid-column: 2;
      min-inline-size: 0;
      display: grid;
      align-content: start;
      justify-items: start;
      gap: 0.5rem;
    }

    .quick-start__step-content p {
      max-inline-size: 65ch;
      margin: 0;
      color: var(--color-text-secondary);
      font-size: 1rem;
      line-height: 1.65;
    }

    .quick-start__resource-link {
      display: inline-flex;
      min-block-size: 44px;
      align-items: center;
      justify-self: start;
      gap: 0.625rem;
      color: var(--color-action);
      font-size: 0.9375rem;
      font-weight: 600;
      text-decoration: none;
    }

    .quick-start__resource-link > span:first-child {
      text-decoration: underline;
      text-underline-offset: 0.25em;
    }

    .quick-start__resource-link:hover {
      color: var(--color-action-hover);
    }

    .quick-start__formats {
      display: grid;
      align-content: start;
      justify-items: start;
      gap: 0.5rem;
      min-inline-size: 0;
      margin-block-start: 0.5rem;
    }

    .quick-start__formats .quick-start__formats-label {
      color: var(--color-text-primary);
      font-size: 0.875rem;
      font-weight: 600;
    }

    .quick-start__format-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .quick-start__format-list code {
      display: block;
      padding: 0.3125rem 0.625rem;
      border: 1px solid var(--line-default);
      border-radius: var(--radius-xs);
      background: var(--color-surface-quiet);
      color: var(--color-text-primary);
      font: 500 0.875rem/1.5 var(--font-mono);
    }

    .quick-start__formats .quick-start__formats-note {
      font-size: 0.875rem;
    }

    @media (min-width: 48rem) {
      .quick-start__step {
        grid-template-columns: 2.5rem minmax(0, 0.65fr) minmax(0, 1.35fr);
        column-gap: clamp(1.25rem, 3vw, 3rem);
      }

      .quick-start__step h3 {
        align-self: start;
        padding-block-start: 0.3rem;
      }

      .quick-start__step-content {
        grid-column: 3;
        padding-block-start: 0.3rem;
      }
    }

    @media (max-width: 23.99rem) {
      .quick-start__step {
        grid-template-columns: 2rem minmax(0, 1fr);
        column-gap: 0.75rem;
      }

      .quick-start__number {
        inline-size: 2rem;
        block-size: 2rem;
      }
    }

    @media (forced-colors: active) {
      .quick-start__steps,
      .quick-start__step,
      .quick-start__number,
      .quick-start__format-list code {
        border-color: CanvasText;
      }

      .quick-start__resource-link {
        color: LinkText;
      }
    }
  }
</style>
