---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  faq: CollectionEntry<'faq'>;
}

const { faq } = Astro.props;
const { Content } = await render(faq);
---

<details class="faq-item" id={faq.data.key} data-faq-item>
  <summary data-faq-question>{faq.data.question}</summary>
  <div class="faq-answer">
    <Content />
  </div>
</details>

<style>
  @layer components {
    .faq-item {
      border-bottom: 1px solid var(--line-faint);
      scroll-margin-top: 6rem;
      padding-block: var(--space-2);
    }
    .faq-item summary {
      display: flex;
      min-block-size: 44px;
      align-items: center;
      font-weight: 600;
      font-size: var(--type-body);
      cursor: pointer;
      list-style: none;
      position: relative;
      padding-inline-end: var(--space-6);
    }
    .faq-item summary::-webkit-details-marker {
      display: none;
    }
    .faq-item summary::after {
      content: '+';
      position: absolute;
      inset-inline-end: 0;
      top: 50%;
      transform: translateY(-50%);
      font-size: 1.5rem;
      color: var(--color-text-secondary);
    }
    .faq-item[open] summary::after {
      content: '−';
    }
    .faq-answer {
      margin-top: var(--space-4);
      color: var(--color-text-tertiary);
    }
    .faq-answer :global(a) {
      color: var(--color-action);
      text-decoration: underline;
    }
    .faq-answer :global(p) {
      margin-bottom: var(--space-4);
    }
    .faq-answer :global(p:last-child) {
      margin-bottom: 0;
    }
    .faq-answer :global(code) {
      font-family: var(--font-mono);
      background: var(--color-surface-quiet);
      padding: 0.1em 0.3em;
      border-radius: 3px;
      font-size: 0.9em;
    }

    @media (forced-colors: active) {
      .faq-item summary::after {
        color: CanvasText;
      }
    }
  }
</style>

<script>
  const listeners = new AbortController();
  const options = { signal: listeners.signal };

  const openFragmentAnswer = (focus: boolean) => {
    let key: string;
    try {
      key = decodeURIComponent(window.location.hash.slice(1));
    } catch {
      return;
    }
    if (!key) return;
    const item = document.getElementById(key);
    if (!(item instanceof HTMLDetailsElement) || !item.matches('[data-faq-item]')) return;
    item.open = true;
    if (focus) {
      item.querySelector<HTMLElement>('[data-faq-question]')?.focus({ preventScroll: true });
    }
  };

  openFragmentAnswer(false);
  window.addEventListener('hashchange', () => openFragmentAnswer(true), options);
  window.addEventListener(
    'pagehide',
    (event) => {
      if (!(event as PageTransitionEvent).persisted) listeners.abort();
    },
    options,
  );
</script>
