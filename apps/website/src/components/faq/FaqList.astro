---
import type { CollectionEntry } from 'astro:content';
import FaqItem from './FaqItem.astro';

interface FaqGroup {
  id: string;
  label: string;
  faqs: CollectionEntry<'faq'>[];
}

interface Props {
  groups: FaqGroup[];
}

const { groups } = Astro.props;
---

<div class="faq-list">
  {groups.map((group) => (
    <section class="faq-list__group" id={group.id} aria-labelledby={`${group.id}-title`}>
      <h2 id={`${group.id}-title`}>{group.label}</h2>
      {group.faqs.map((faq) => (
        <FaqItem faq={faq} />
      ))}
    </section>
  ))}
</div>

<style>
  @layer components {
    .faq-list {
      min-inline-size: 0;
    }

    .faq-list__group + .faq-list__group {
      margin-block-start: var(--space-6);
    }

    .faq-list__group h2 {
      margin-block-end: var(--space-2);
      font-family: var(--font-body);
      font-size: var(--type-h3);
      font-weight: 650;
    }
  }
</style>
