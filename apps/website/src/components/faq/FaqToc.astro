---
import type { Locale } from '../../data/site';

interface FaqGroup {
  id: string;
  label: string;
}

interface Props {
  locale: Locale;
  groups: FaqGroup[];
}

const { locale, groups } = Astro.props;
---

<details class="faq-toc" open>
  <summary>{locale === 'vi' ? 'Chủ đề' : 'Topics'}</summary>
  <nav aria-label={locale === 'vi' ? 'Chủ đề FAQ' : 'FAQ topics'}>
    <ul>
      {groups.map((group) => (
        <li>
          <a href={`#${group.id}`}>{group.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</details>

<style>
  @layer components {
    .faq-toc {
      align-self: start;
    }

    .faq-toc summary {
      display: flex;
      min-block-size: 44px;
      align-items: center;
      color: var(--color-text-primary);
      font-size: var(--type-small);
      font-weight: 650;
      cursor: pointer;
    }

    .faq-toc ul {
      display: grid;
      gap: 0.2rem;
      margin: 0;
      padding: 0 0 var(--space-2);
      list-style: none;
    }

    .faq-toc a {
      display: flex;
      min-block-size: 44px;
      align-items: center;
      color: var(--color-text-tertiary);
      font-size: var(--type-small);
      text-underline-offset: 0.2em;
    }

    .faq-toc a:hover {
      color: var(--color-text-primary);
    }

    @media (min-width: 64rem) {
      .faq-toc {
        position: sticky;
        top: 5.5rem;
        max-block-size: calc(100dvh - 6.5rem);
        overflow-y: auto;
        overscroll-behavior: contain;
      }
    }
  }
</style>
