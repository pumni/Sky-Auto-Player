---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Locale } from '../../data/site';
import FaqToc from './FaqToc.astro';
import FaqList from './FaqList.astro';

interface Props {
  locale: Locale;
  seo: {
    title: string;
    description: string;
  };
}

const { locale, seo } = Astro.props;
const isVi = locale === 'vi';
const faqs = (await getCollection('faq', ({ data }) => data.locale === locale)).sort(
  (a, b) => a.data.order - b.data.order,
);
const categoryOrder = ['General', 'Formats', 'Safety', 'Troubleshooting'];
const categoryLabels: Record<string, string> = isVi
  ? {
      General: 'Cài đặt & sử dụng',
      Formats: 'Định dạng sheet',
      Safety: 'An toàn',
      Troubleshooting: 'Khắc phục sự cố',
    }
  : {
      General: 'Setup & use',
      Formats: 'Sheet formats',
      Safety: 'Safety',
      Troubleshooting: 'Troubleshooting',
    };
const groups = categoryOrder
  .map((category) => ({
    id: `faq-group-${category.toLowerCase()}`,
    label: categoryLabels[category],
    faqs: faqs.filter((faq) => faq.data.category === category),
  }))
  .filter((group) => group.faqs.length > 0);

function plainText(markdown: string): string {
  return markdown
    .replace(/!\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/[`*_>#~-]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
}

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq: CollectionEntry<'faq'>) => ({
    '@type': 'Question',
    name: faq.data.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: plainText(faq.body ?? ''),
    },
  })),
};
---

<BaseLayout locale={locale} seo={seo} structuredData={structuredData}>
  <header class="faq-header container" aria-labelledby="faq-title">
    <h1 id="faq-title">{isVi ? 'Câu hỏi thường gặp' : 'FAQ'}</h1>
    <p>
      {isVi
        ? 'Câu trả lời ngắn về cài đặt, định dạng, an toàn và khắc phục sự cố.'
        : 'Quick answers about setup, formats, safety, and troubleshooting.'}
    </p>
  </header>

  <div class="container faq-layout">
    <FaqToc locale={locale} groups={groups} />
    <FaqList groups={groups} />
  </div>
</BaseLayout>

<style>
  @layer components {
    .faq-layout {
      display: grid;
      gap: var(--space-6);
      margin-bottom: var(--section-default);
    }

    @media (min-width: 64rem) {
      .faq-layout {
        grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
      }
    }

    .faq-header {
      padding-block: clamp(2rem, 4vw, 3rem) var(--space-5);
    }

    .faq-header h1 {
      margin-block-end: var(--space-2);
    }

    .faq-header p {
      max-inline-size: 58ch;
      margin: 0;
      color: var(--color-text-secondary);
      font-size: var(--type-body);
    }
  }
</style>
