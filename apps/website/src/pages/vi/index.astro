---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomePage from '../../components/home/HomePage.astro';
import { homeVi } from '../../data/home.vi';
import { SITE } from '../../data/site';
import { withBase } from '../../utils/urls';

const siteUrlEn = new URL(withBase('/'), SITE.productionOrigin).href;
const siteUrlVi = new URL(withBase('/vi/'), SITE.productionOrigin).href;
const softwareId = `${siteUrlEn}#software`;
const siteViId = `${siteUrlVi}#website`;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': siteViId,
      name: 'Sky Auto Player',
      url: siteUrlVi,
      inLanguage: 'vi',
      mainEntity: { '@id': softwareId },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': softwareId,
      name: 'Sky Auto Player',
      description: homeVi.seo.description,
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'Windows 11 (64-bit)',
      url: siteUrlEn,
      image: new URL(withBase('/assets/og-banner.jpg'), SITE.productionOrigin).href,
      downloadUrl: SITE.stableReleaseUrl,
      license: 'https://www.gnu.org/licenses/gpl-3.0.html',
      isAccessibleForFree: true,
      inLanguage: 'vi',
      offers: {
        '@type': 'Offer',
        price: 0,
      },
    },
  ],
};
---

<BaseLayout locale="vi" seo={homeVi.seo} structuredData={structuredData}>
  <HomePage content={homeVi} />
</BaseLayout>
