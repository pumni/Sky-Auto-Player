# Auto detect text files and perform LF normalization
* text=auto
# Exported startup-calibration JSON and sidecars use LF checkout representation.
docs/evidence/wake-calibration-qualification-*.json text eol=lf
docs/evidence/wake-calibration-qualification-*.json.sha256 text eol=lf
songs/** text eol=lf
builtin-songs/manifest.json text eol=lf
rust/supply-chain/*.toml text eol=lf
rust/supply-chain/*.lock text eol=lf
**/Cargo.toml text eol=lf
Cargo.toml text eol=lf
# Historical byte-identical song fixtures must not gain CRLF on Windows checkouts.
tests/fixtures/song_planning/historical_sources/*.json text eol=lf
