{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Minimum permissions for the local Sky Auto Player desktop window.",
  "windows": ["main"],
  "platforms": ["windows"],
  "permissions": [
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "allow-bootstrap",
    "allow-shutdown",
    "allow-search-songs",
    "allow-get-song-detail",
    "allow-reload-library",
    "allow-set-library-viewport",
    "allow-set-song-liked",
    "allow-get-settings",
    "allow-patch-settings",
    "allow-check-for-update",
    "allow-get-update-preferences",
    "allow-patch-update-preferences",
    "allow-begin-update-handoff",
    "allow-prepare-playback",
    "allow-start-playback",
    "allow-stop-playback",
    "allow-pause-playback",
    "allow-resume-playback",
    "allow-skip-playback",
    "allow-set-diagnostics-enabled",
    "allow-start-calibration",
    "allow-cancel-calibration",
    "allow-library-list-playlists",
    "allow-library-create-playlist",
    "allow-library-rename-playlist",
    "allow-library-delete-playlist",
    "allow-library-add-songs",
    "allow-library-remove-songs",
    "allow-library-import-local-files-to-playlist",
    "allow-library-import-local-folder-to-playlist",
    "allow-subscribe-ui-events"
  ]
}
