---
import type { Locale } from '../../data/site';
import { SITE } from '../../data/site';
import { withBase } from '../../utils/urls';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isVi = locale === 'vi';
---

<footer class="site-footer">
  <div class="container site-footer__layout">
    <div class="site-footer__identity">
      <p>
        {
          isVi
            ? 'Sky Auto Player · Mã nguồn mở theo GNU GPL v3.0 · Xây dựng cho cộng đồng âm nhạc Sky'
            : 'Sky Auto Player · Open source under GNU GPL v3.0 · Built for the Sky music community'
        }
      </p>
    </div>
    <nav class="site-footer__links" aria-label={isVi ? 'Chân trang' : 'Footer'}>
      <a href={withBase(isVi ? '/vi/faq/' : '/faq/')}>FAQ</a>
      <a href={SITE.repositoryUrl}>GitHub</a>
      <a href={`${SITE.repositoryUrl}/releases`}>{isVi ? 'Bản phát hành' : 'Releases'}</a>
      <a href={`${SITE.repositoryUrl}/blob/main/LICENSE`}>{isVi ? 'Giấy phép' : 'License'}</a>
      <a href={`${SITE.repositoryUrl}/discussions`}>Discussions</a>
      <a href={withBase(isVi ? '/' : '/vi/')}>{isVi ? 'English' : 'Tiếng Việt'}</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line-faint);
    padding-block: var(--section-xs);
    color: var(--color-text-tertiary);
    font-size: var(--type-small);
  }

  .site-footer__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--space-7);
    align-items: end;
  }

  .site-footer__identity {
    display: grid;
    gap: var(--space-4);
  }

  .site-footer__identity p {
    max-inline-size: 34rem;
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-3) var(--space-5);
  }

  .site-footer__links a {
    color: var(--color-text-secondary);
  }

  .site-footer__links a:hover {
    color: var(--color-text-primary);
  }

  @media (max-width: 48rem) {
    .site-footer__layout {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .site-footer__links {
      justify-content: flex-start;
    }
  }
</style>
