---
import type { HomeContent } from '../../data/home.types';
import SectionIntro from '../ui/SectionIntro.astro';

interface Props {
  data: HomeContent['playback'];
  locale: 'en' | 'vi';
}

const { data, locale } = Astro.props;
const isVi = locale === 'vi';
const diagramLabels = isVi
  ? ['SỰ KIỆN SHEET', 'CỬA SỔ TIMING', 'INPUT THEO BATCH']
  : ['SHEET EVENT', 'TIMING WINDOW', 'BATCHED INPUT'];
---

<section id="playback" class="section-shell section-shell--open" aria-labelledby="playback-title">
  <div class="container playback-proof__layout">
    <div class="playback-proof__intro">
      <SectionIntro
        kicker={data.kicker}
        title={data.title}
        description={data.description}
        titleId="playback-title"
        measure="narrow"
      />
      <ul class="proof-points" aria-label={isVi ? 'Năng lực phát nhạc' : 'Playback capabilities'}>
        {data.points.map((point) => <li>{point}</li>)}
      </ul>
    </div>

    <div class="causal-diagram">
      <div class="causal-diagram__header">
        <span>{isVi ? 'MÔ HÌNH NGUYÊN NHÂN' : 'CAUSAL TIMING MODEL'}</span>
        <span class="causal-diagram__status"
          >{isVi ? 'MỘT LẦN / ỔN ĐỊNH' : 'ONE PASS / STABLE'}</span
        >
      </div>
      <div class="causal-diagram__lane" aria-hidden="true">
        <span class="causal-diagram__line"></span>
        <span class="causal-node causal-node--source">01</span>
        <span class="causal-node causal-node--window">02</span>
        <span class="causal-node causal-node--input">03</span>
      </div>
      <ol
        class="causal-steps"
        aria-label={isVi ? 'Các bước căn chỉnh timing' : 'Timing alignment steps'}
      >
        {
          diagramLabels.map((label, index) => (
            <li>
              <span class="causal-step__number">{String(index + 1).padStart(2, '0')}</span>
              <span class="causal-step__label">{label}</span>
              <span class="causal-step__value">
                {index === 0
                  ? 'A1 + B2 + C3'
                  : index === 1
                    ? '00:13.066'
                    : isVi
                      ? 'CÙNG BATCH GỬI'
                      : 'SAME SEND BATCH'}
              </span>
            </li>
          ))
        }
      </ol>
      <div class="causal-events" aria-label={isVi ? 'Ví dụ trường độ' : 'Duration example'}>
        <span class="causal-events__caption">{isVi ? 'TRƯỜNG ĐỘ' : 'DURATION'}</span>
        <span class="causal-event causal-event--chord">A1+B2+C3</span>
        <span class="causal-event causal-event--note">D2</span>
        <span class="causal-event causal-event--hold">E3 <i aria-hidden="true"></i></span>
      </div>
    </div>
  </div>
</section>

<style>
  .playback-proof__layout {
    display: grid;
    gap: var(--space-8);
  }

  .playback-proof__intro,
  .causal-diagram {
    min-width: 0;
  }

  .proof-points {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-7) 0 0;
    padding: 0;
    list-style: none;
  }

  .proof-points li {
    position: relative;
    padding-inline-start: var(--space-5);
    color: var(--color-text-secondary);
  }

  .proof-points li::before {
    position: absolute;
    top: 0.72em;
    left: 0;
    width: 0.45rem;
    height: 0.45rem;
    border: 1px solid var(--color-action);
    content: '';
    transform: translateY(-50%);
  }

  .causal-diagram {
    position: relative;
    padding-block: var(--space-2);
    container: causal-diagram / inline-size;
  }

  .causal-diagram::after {
    position: absolute;
    top: 0;
    right: 0;
    width: 18%;
    height: 1px;
    background: var(--color-action);
    content: '';
  }

  .causal-diagram__header,
  .causal-step__label,
  .causal-events__caption {
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .causal-diagram__header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .causal-diagram__status {
    color: var(--color-success);
  }

  .causal-diagram__lane {
    position: relative;
    display: flex;
    justify-content: space-between;
    margin-block: var(--space-8) var(--space-3);
  }

  .causal-diagram__line {
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
    height: 1px;
    background: var(--line-accent);
  }

  .causal-node {
    position: relative;
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border: 1px solid var(--color-action);
    border-radius: 50%;
    background: var(--color-page);
    color: var(--color-action-soft);
    font-family: var(--font-mono);
    font-size: var(--type-micro);
  }

  .causal-node--window {
    border-color: var(--color-info);
    color: var(--color-info);
  }

  .causal-node--input {
    border-color: var(--color-success);
    color: var(--color-success);
  }

  .causal-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .causal-steps li {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-4);
    border-block-start: 1px solid var(--line-faint);
    border-inline-start: 1px solid var(--line-faint);
  }

  .causal-steps li:first-child {
    padding-inline-start: 0;
    border-inline-start: 0;
  }

  .causal-steps li:last-child {
    border-block-end: 1px solid var(--line-faint);
  }

  .causal-step__number,
  .causal-step__value {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .causal-step__number {
    color: var(--color-action);
    font-size: var(--type-label);
  }

  .causal-step__value {
    color: var(--color-text-primary);
    font-size: var(--type-small);
  }

  .causal-events {
    display: grid;
    grid-template-columns: auto 1fr 0.65fr 1.35fr;
    gap: var(--space-3);
    align-items: center;
    margin-block-start: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--type-micro);
  }

  .causal-events__caption {
    color: var(--color-text-tertiary);
  }

  .causal-event {
    min-width: 0;
    overflow: hidden;
    color: var(--color-text-primary);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .causal-event::before {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-inline-end: var(--space-2);
    border: 1px solid currentColor;
    content: '';
  }

  .causal-event--chord {
    color: var(--color-action-soft);
  }

  .causal-event--chord::before {
    border-radius: 0.1rem;
  }

  .causal-event--note {
    color: var(--color-info);
  }

  .causal-event--note::before {
    border-radius: 50%;
  }

  .causal-event--hold {
    color: var(--color-success);
  }

  .causal-event--hold i {
    display: inline-block;
    width: 2.5rem;
    height: 0.2rem;
    margin-inline-start: var(--space-2);
    vertical-align: middle;
    background: currentColor;
  }

  @media (min-width: 64rem) {
    .playback-proof__layout {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--grid-gap);
      align-items: start;
    }

    .playback-proof__intro {
      padding-block-start: var(--space-2);
    }
  }

  @container causal-diagram (width < 34rem) {
    .causal-diagram__lane {
      display: none;
    }

    .causal-steps {
      grid-template-columns: 1fr;
      margin-block-start: var(--space-5);
      border-inline-start: 1px solid var(--line-accent);
    }

    .causal-steps li {
      grid-template-columns: 2rem minmax(0, 1fr);
      margin-inline-start: -1px;
      padding-inline: var(--space-4) 0;
      border-inline-start: 1px solid var(--line-faint);
    }

    .causal-step__value {
      grid-column: 2;
    }

    .causal-events {
      grid-template-columns: 1fr 1fr;
    }

    .causal-events__caption {
      grid-column: 1 / -1;
    }
  }
</style>
