---
import type { HomeContent } from '../../data/home.types';

interface Props {
  data: HomeContent['playback'];
  locale: 'en' | 'vi';
}
const { data, locale } = Astro.props;
const isVi = locale === 'vi';
---

<section id="playback" class="section-shell" aria-labelledby="playback-title">
  <div class="container playback-proof__layout">
    <div class="section-heading">
      <p class="kicker">{data.kicker}</p>
      <h2 id="playback-title" class="section-title">{data.title}</h2>
      <p class="section-copy">{data.description}</p>
      <ul class="proof-points" aria-label={isVi ? 'Năng lực phát nhạc' : 'Playback capabilities'}>
        {data.points.map((point) => <li>{point}</li>)}
      </ul>
    </div>

    <div class="playback-stage">
      <div class="playback-stage__header">
        <span>{isVi ? 'CỬA SỔ ĐỒNG BỘ' : 'SYNC WINDOW'}</span>
        <span class="playback-stage__state"
          ><span class="playback-stage__dot" aria-hidden="true"></span>{
            isVi ? 'ỔN ĐỊNH' : 'STABLE'
          }</span
        >
      </div>
      <div class="playback-stage__playhead" aria-hidden="true">
        <span>{isVi ? 'VỊ TRÍ PHÁT' : 'PLAYHEAD'}</span>
        <span>00:13.066</span>
      </div>
      <ol
        class="proof-track"
        aria-label={isVi ? 'Căn chỉnh sự kiện theo thời gian' : 'Time-aligned playback events'}
      >
        <li class="proof-track__row">
          <span class="proof-track__time">00:12.400</span>
          <span class="proof-track__event"
            >A1 + B2 + C3 <span class="proof-track__type"
              >{isVi ? 'HỢP ÂM · đến cùng lúc' : 'CHORD · arrive together'}</span
            ></span
          >
        </li>
        <li class="proof-track__row">
          <span class="proof-track__time">00:12.733</span>
          <span class="proof-track__event"
            >D4 <span class="proof-track__type"
              >{isVi ? 'NỐT · giữ khoảng cách' : 'NOTE · keep spacing'}</span
            ></span
          >
        </li>
        <li class="proof-track__row proof-track__row--active">
          <span class="proof-track__time">00:13.066</span>
          <span class="proof-track__event"
            >E5 <span class="hold-glyph" aria-hidden="true"></span><span class="proof-track__type"
              >{isVi ? 'NỐT NGÂN · giữ trường độ' : 'HOLD · preserve duration'}</span
            ></span
          >
        </li>
      </ol>
      <div class="playback-stage__legend">
        <span
          ><i class="legend-dot legend-dot--chord" aria-hidden="true"></i>{
            isVi ? 'Hợp âm' : 'Chord'
          }</span
        >
        <span
          ><i class="legend-dot legend-dot--note" aria-hidden="true"></i>{
            isVi ? 'Nốt' : 'Note'
          }</span
        >
        <span
          ><i class="legend-dot legend-dot--hold" aria-hidden="true"></i>{
            isVi ? 'Nốt ngân' : 'Hold'
          }</span
        >
      </div>
    </div>
  </div>
</section>

<style>
  .playback-proof__layout {
    display: grid;
    gap: var(--space-8);
  }
  @media (min-width: 64rem) {
    .playback-proof__layout {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      align-items: start;
    }
  }
  .section-heading {
    min-width: 0;
    max-width: 38rem;
  }
  .kicker {
    margin-bottom: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .section-title {
    margin-bottom: var(--space-4);
  }
  .section-copy {
    margin-bottom: var(--space-6);
    color: var(--color-text-subtle);
  }
  .proof-points {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .proof-points li {
    position: relative;
    padding-left: var(--space-5);
    color: var(--color-text-muted);
  }
  .proof-points li::before {
    position: absolute;
    top: 0.72em;
    left: 0;
    width: 0.5rem;
    height: 0.5rem;
    border: 1px solid var(--color-accent);
    border-radius: 50%;
    content: '';
    transform: translateY(-50%);
  }
  .playback-stage {
    position: relative;
    min-width: 0;
    padding: clamp(var(--space-5), 4vw, var(--space-7));
    overflow: hidden;
    border: 1px solid var(--border-default);
    background: var(--color-surface-1);
  }
  .playback-stage::after {
    position: absolute;
    top: 0;
    left: 12%;
    width: 7rem;
    height: 1px;
    background: var(--color-accent);
    content: '';
  }
  .playback-stage__header,
  .playback-stage__playhead,
  .playback-stage__legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .playback-stage__state {
    color: var(--color-success);
  }
  .playback-stage__dot {
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: var(--space-2);
    border-radius: 50%;
    background: var(--color-success);
    box-shadow: 0 0 0 3px rgb(169 203 183 / 12%);
  }
  .playback-stage__playhead {
    align-items: center;
    margin-top: var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-accent);
    color: var(--color-accent-strong);
  }
  .proof-track {
    position: relative;
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0 0 0 var(--space-6);
    list-style: none;
    font-family: var(--font-mono);
  }
  .proof-track::before {
    position: absolute;
    top: 0.9rem;
    bottom: 0.9rem;
    left: 0.35rem;
    width: 1px;
    background: var(--border-accent);
    content: '';
  }
  .proof-track__row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(5.8rem, 0.38fr) minmax(0, 1fr);
    gap: var(--space-4);
    min-width: 0;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
  }
  .proof-track__row::before {
    position: absolute;
    top: 1.35rem;
    left: calc((var(--space-6) * -1) + 0.1rem);
    width: 0.55rem;
    height: 0.55rem;
    border: 1px solid var(--color-accent-strong);
    border-radius: 50%;
    background: var(--color-surface-1);
    content: '';
  }
  .proof-track__row--active::before {
    background: var(--color-accent);
    box-shadow: 0 0 0 4px rgb(239 202 120 / 12%);
  }
  .proof-track__time {
    color: var(--color-accent-strong);
    font-size: var(--font-size-sm);
    white-space: nowrap;
  }
  .proof-track__event {
    min-width: 0;
    color: var(--color-text);
    font-size: var(--font-size-body);
    overflow-wrap: anywhere;
  }
  .proof-track__type {
    display: block;
    margin-top: var(--space-1);
    color: var(--color-sky);
    font-size: var(--font-size-xs);
    letter-spacing: 0.04em;
  }
  .hold-glyph {
    display: inline-block;
    width: 3.25rem;
    height: 0.2rem;
    margin-inline: var(--space-2);
    vertical-align: middle;
    background: var(--color-success);
  }
  .playback-stage__legend {
    justify-content: flex-start;
    margin-top: var(--space-5);
    gap: var(--space-4);
    letter-spacing: 0.03em;
  }
  .playback-stage__legend span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .legend-dot {
    display: inline-block;
    width: 0.55rem;
    height: 0.55rem;
    border: 1px solid currentColor;
    border-radius: 50%;
  }
  .legend-dot--chord {
    border-radius: 0.1rem;
    color: var(--color-accent);
  }
  .legend-dot--note {
    color: var(--color-sky);
  }
  .legend-dot--hold {
    width: 1rem;
    height: 0.2rem;
    border: 0;
    border-radius: 0;
    background: var(--color-success);
  }
  @media (max-width: 40rem) {
    .proof-track__row {
      grid-template-columns: max-content minmax(0, 1fr);
      gap: var(--space-3);
    }
    .hold-glyph {
      width: 2rem;
    }
  }
</style>
