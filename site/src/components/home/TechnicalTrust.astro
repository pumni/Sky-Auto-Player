---
import type { HomeContent } from '../../data/home.types';
import { withBase } from '../../utils/urls';
import SectionIntro from '../ui/SectionIntro.astro';

interface Props {
  data: HomeContent['technical'];
  locale: 'en' | 'vi';
}

const { data, locale } = Astro.props;
---

<section
  id="technical"
  class="technical-section section-shell section-shell--utility"
  aria-labelledby="technical-title"
>
  <div class="container technical-trust__layout">
    <SectionIntro
      kicker={data.kicker}
      title={data.title}
      description={data.description}
      titleId="technical-title"
      measure="narrow"
    />
    <div>
      <dl class="technical-ledger">
        {
          data.ledger.map((item) => (
            <div class="ledger-row">
              <dt>
                <span class="ledger-row__marker" aria-hidden="true" />
                {item.term}
              </dt>
              <dd>{item.definition}</dd>
              <dd class:list={['ledger-row__state', `ledger-row__state--${item.state}`]}>
                {item.state === 'yes' ? 'YES' : item.state === 'no' ? 'NO' : 'INFO'}
              </dd>
            </div>
          ))
        }
      </dl>
      <p class="notice">
        <span class="notice__label">{locale === 'vi' ? 'LƯU Ý' : 'NOTICE'}</span>
        <span>{data.notice}</span>
        <a href={withBase(locale === 'vi' ? '/vi/faq/#account-safety' : '/faq/#account-safety')}>
          {locale === 'vi' ? 'Đọc hướng dẫn về rủi ro tài khoản' : 'Read the account-risk guidance'}
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  .technical-trust__layout {
    display: grid;
    gap: var(--space-8);
  }

  .technical-section {
    background: color-mix(in oklch, var(--color-surface-quiet) 34%, var(--color-page));
  }

  .technical-ledger {
    display: grid;
    grid-template-columns: minmax(8rem, 0.35fr) minmax(0, 0.65fr) auto;
    margin: 0 0 var(--space-6);
    border-block-start: 1px solid var(--line-default);
  }

  .ledger-row {
    display: grid;
    grid-template-columns: minmax(8rem, 0.35fr) minmax(0, 0.65fr) auto;
    grid-column: 1 / -1;
    align-items: baseline;
    gap: var(--space-5);
    padding-block: var(--space-3);
    border-block-end: 1px solid var(--line-faint);
  }

  @supports (grid-template-columns: subgrid) {
    .ledger-row {
      grid-template-columns: subgrid;
    }
  }

  .ledger-row dt,
  .ledger-row dd {
    min-width: 0;
    margin: 0;
  }

  .ledger-row dt {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-primary);
    font-weight: 650;
  }

  .ledger-row__marker {
    width: 0.45rem;
    height: 0.45rem;
    flex: 0 0 auto;
    border: 1px solid var(--color-success);
    border-radius: 50%;
  }

  .ledger-row__state {
    min-width: 3.2rem;
    color: var(--color-text-tertiary);
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    letter-spacing: 0.06em;
    text-align: end;
  }

  .ledger-row__state--yes {
    color: var(--color-success);
  }

  .ledger-row__state--no {
    color: var(--color-info);
  }

  .ledger-row dd {
    color: var(--color-text-secondary);
  }

  .notice {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
    border-inline-start: 2px solid var(--color-warning);
    background: color-mix(in oklch, var(--color-warning) 5%, var(--color-surface-quiet));
    color: var(--color-text-secondary);
    font-size: var(--type-small);
  }

  .notice__label {
    color: var(--color-warning);
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    letter-spacing: 0.08em;
  }

  .notice a {
    width: fit-content;
    min-height: 44px;
    align-content: center;
    color: var(--color-text-primary);
    text-decoration: underline;
  }

  @media (min-width: 64rem) {
    .technical-trust__layout {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--grid-gap);
    }
  }

  @media (max-width: 40rem) {
    .technical-ledger {
      grid-template-columns: minmax(6.5rem, 0.4fr) minmax(0, 0.6fr) auto;
    }

    .ledger-row {
      gap: var(--space-3);
    }
  }
</style>
