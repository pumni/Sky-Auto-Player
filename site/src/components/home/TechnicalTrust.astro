---
import type { HomeContent } from '../../data/home.types';
import SectionIntro from '../ui/SectionIntro.astro';

interface Props {
  data: HomeContent['technical'];
  locale: 'en' | 'vi';
}

const { data, locale } = Astro.props;
---

<section
  id="technical"
  class="technical-section section-shell section-shell--utility"
  aria-labelledby="technical-title"
>
  <div class="container technical-trust__layout">
    <SectionIntro
      kicker={data.kicker}
      title={data.title}
      description={data.description}
      titleId="technical-title"
      measure="narrow"
    />
    <div>
      <dl class="technical-ledger">
        {
          data.ledger.map((item) => (
            <div class="ledger-row">
              <dt>
                <span class="ledger-row__marker" aria-hidden="true" />
                {item.term}
              </dt>
              <dd>{item.definition}</dd>
            </div>
          ))
        }
      </dl>
      <p class="notice">
        <span class="notice__label">{locale === 'vi' ? 'LƯU Ý' : 'NOTICE'}</span>{data.notice}
      </p>
    </div>
  </div>
</section>

<style>
  .technical-trust__layout {
    display: grid;
    gap: var(--space-8);
  }

  .technical-section {
    background: color-mix(in oklch, var(--color-surface-quiet) 34%, var(--color-page));
  }

  .technical-ledger {
    display: grid;
    grid-template-columns: minmax(8rem, 0.35fr) minmax(0, 0.65fr);
    margin: 0 0 var(--space-6);
    border-block-start: 1px solid var(--line-default);
  }

  .ledger-row {
    display: grid;
    grid-template-columns: minmax(8rem, 0.35fr) minmax(0, 0.65fr);
    grid-column: 1 / -1;
    align-items: baseline;
    gap: var(--space-5);
    padding-block: var(--space-3);
    border-block-end: 1px solid var(--line-faint);
  }

  @supports (grid-template-columns: subgrid) {
    .ledger-row {
      grid-template-columns: subgrid;
    }
  }

  .ledger-row dt,
  .ledger-row dd {
    min-width: 0;
    margin: 0;
  }

  .ledger-row dt {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-primary);
    font-weight: 650;
  }

  .ledger-row__marker {
    width: 0.45rem;
    height: 0.45rem;
    flex: 0 0 auto;
    border: 1px solid var(--color-success);
    border-radius: 50%;
  }

  .ledger-row dd {
    color: var(--color-text-secondary);
  }

  .notice {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
    border-inline-start: 2px solid var(--color-warning);
    background: color-mix(in oklch, var(--color-warning) 5%, var(--color-surface-quiet));
    color: var(--color-text-secondary);
    font-size: var(--type-small);
  }

  .notice__label {
    color: var(--color-warning);
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    letter-spacing: 0.08em;
  }

  @media (min-width: 64rem) {
    .technical-trust__layout {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--grid-gap);
    }
  }

  @media (max-width: 40rem) {
    .technical-ledger {
      grid-template-columns: minmax(7rem, 0.4fr) minmax(0, 0.6fr);
    }

    .ledger-row {
      gap: var(--space-3);
    }
  }
</style>
