---
import type { HomeContent } from '../../data/home.types';
import { SITE } from '../../data/site';
import ConstellationMark from '../ui/ConstellationMark.astro';

interface Props {
  data: HomeContent['finalCta'];
  locale: 'en' | 'vi';
}

const { data, locale } = Astro.props;
---

<section class="final-cta section-shell section-shell--feature" aria-labelledby="final-title">
  <div class="container final-cta__layout">
    <div class="final-cta__copy">
      <p class="final-cta__eyebrow">
        {locale === 'vi' ? 'SẴN SÀNG CHO MÀN TRÌNH DIỄN' : 'READY FOR THE PERFORMANCE'}
      </p>
      <h2 id="final-title">{data.title}</h2>
      <p class="final-cta__description">{data.description}</p>
    </div>
    <div class="final-cta__actions">
      <a class="button button--primary" href={SITE.releaseUrl}>{data.primaryCta}</a>
      <a class="button button--secondary" href={SITE.repositoryUrl}>{data.secondaryCta}</a>
      <span class="final-cta__metric">JSON · SKYSHEET · TXT / WINDOWS 10–11</span>
    </div>
    <span class="final-cta__mark" aria-hidden="true"><ConstellationMark /></span>
  </div>
</section>

<style>
  .final-cta {
    position: relative;
    overflow: hidden;
    border-block: 1px solid var(--line-default);
    background: var(--color-surface-quiet);
  }

  .final-cta__layout {
    position: relative;
    display: grid;
    gap: var(--space-7);
  }

  .final-cta__copy,
  .final-cta__actions {
    position: relative;
    z-index: 1;
  }

  .final-cta__eyebrow,
  .final-cta__metric {
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .final-cta__eyebrow {
    margin-block-end: var(--space-3);
    color: var(--color-text-secondary);
  }

  .final-cta h2 {
    max-width: 10ch;
    margin-block-end: var(--space-4);
    font-size: var(--type-h2);
  }

  .final-cta__description {
    color: var(--color-text-secondary);
  }

  .final-cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .final-cta__metric {
    flex-basis: 100%;
    color: var(--color-text-tertiary);
  }

  .final-cta__mark {
    position: absolute;
    left: -2rem;
    bottom: -2rem;
    color: var(--color-action);
    opacity: 0.10;
    transform: scale(2.5);
    transform-origin: left bottom;
  }

  @media (min-width: 64rem) {
    .final-cta__layout {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--grid-gap);
      align-items: center;
    }

    .final-cta__copy {
      grid-column: 1 / span 7;
    }

    .final-cta__actions {
      grid-column: 8 / -1;
      justify-content: flex-start;
    }
  }

  @media (max-width: 40rem) {
    .final-cta__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .final-cta__metric {
      margin-block-start: var(--space-2);
    }
  }
</style>
