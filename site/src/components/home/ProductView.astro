---
import type { HomeContent } from '../../data/home.types';
import { withBase } from '../../utils/urls';
import SectionIntro from '../ui/SectionIntro.astro';

interface Props {
  data: HomeContent['product'];
  locale: 'en' | 'vi';
}

const { data, locale } = Astro.props;
---

<section
  class="product-showcase section-shell section-shell--peak section-shell--bordered"
  aria-labelledby="product-title"
>
  <div class="product-showcase__atmosphere" aria-hidden="true"></div>
  <div class="container product-view__layout">
    <figure class="screenshot-frame ui-product-stage">
      <div class="screenshot-frame__bar">
        <span>SKY AUTO PLAYER / DESKTOP</span>
        <span>REAL TAURI WINDOW / NSIS INSTALLER</span>
      </div>
      <a
        class="screenshot-link"
        href={withBase('/assets/images/library-real-tauri.png')}
        aria-label={locale === 'vi'
          ? 'Mở ảnh giao diện desktop kích thước lớn'
          : 'Open desktop GUI screenshot at full size'}
      >
        <picture>
          <source
            media="(max-width: 40rem)"
            srcset={withBase('/assets/images/minimum-real-tauri.png')}
            width="920"
            height="620"
          />
          <img
            src={withBase('/assets/images/library-real-tauri.png')}
            alt={locale === 'vi'
              ? 'Giao diện Library desktop của Sky Auto Player'
              : 'Sky Auto Player desktop Library'}
            width="1214"
            height="798"
          />
        </picture>
      </a>
      <figcaption>
        <span
          >{locale === 'vi' ? 'Giao diện desktop chính thức' : 'Canonical desktop interface'}</span
        >
        <span class="screenshot-frame__caption-meta">PNG · REAL TAURI WINDOW</span>
      </figcaption>
    </figure>

    <div class="product-view__copy">
      <SectionIntro
        kicker={data.kicker}
        title={data.title}
        description={data.description}
        titleId="product-title"
        measure="narrow"
      />
      <ol
        class="annotations"
        aria-label={locale === 'vi' ? 'Điểm nổi bật trong sản phẩm' : 'Product annotations'}
      >
        {
          data.annotations.map((ann, i) => (
            <li>
              <span class="anno-num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span>{ann}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .product-showcase {
    position: relative;
    overflow: clip;
    border-block: 1px solid var(--line-default);
    background: var(--color-surface-quiet);
    isolation: isolate;
  }

  .product-showcase__atmosphere {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0 3.1rem,
      rgb(244 239 227 / 3.5%) 3.1rem 3.15rem
    );
    mask-image: linear-gradient(90deg, transparent, black 14%, black 82%, transparent);
    pointer-events: none;
  }

  .product-view__layout {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-7);
  }

  .screenshot-frame {
    min-width: 0;
    margin: 0;
    padding: var(--space-3);
    position: relative;
    z-index: 1;
  }

  .screenshot-frame__bar,
  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .screenshot-frame__bar {
    padding: var(--space-2) var(--space-2) var(--space-3);
  }

  .screenshot-frame__bar span:first-child {
    color: var(--color-text-primary);
  }

  .screenshot-link,
  .screenshot-link picture {
    display: block;
  }

  .screenshot-frame img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line-faint);
    border-radius: var(--radius-sm);
    transition: border-color var(--duration-fast) var(--ease-standard);
  }

  .screenshot-link:hover img,
  .screenshot-link:focus-visible img {
    border-color: var(--color-action);
  }

  figcaption {
    padding: var(--space-3) var(--space-2) var(--space-2);
    color: var(--color-text-secondary);
  }

  .screenshot-frame__caption-meta {
    color: var(--color-text-tertiary);
  }

  .product-view__copy {
    min-width: 0;
    position: relative;
    z-index: 2;
    padding-block: var(--space-4);
  }

  .annotations {
    position: relative;
    display: grid;
    gap: 0;
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .annotations::before {
    position: absolute;
    top: 0.8rem;
    bottom: 0.8rem;
    left: 0.75rem;
    width: 1px;
    background: var(--line-accent);
    content: '';
  }

  .annotations li {
    position: relative;
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
    padding-block: var(--space-4);
    color: var(--color-text-secondary);
    border-block-end: 1px solid var(--line-faint);
  }

  .annotations li:last-child {
    border-block-end: 0;
  }

  .anno-num {
    position: relative;
    z-index: 1;
    display: grid;
    width: 1.5rem;
    height: 1.5rem;
    place-items: center;
    border: 1px solid var(--color-action);
    border-radius: 50%;
    background: var(--color-surface-quiet);
    color: var(--color-action-soft);
    font-family: var(--font-mono);
    font-size: var(--type-micro);
  }

  @media (min-width: 64rem) {
    .product-view__layout {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--grid-gap);
      align-items: center;
    }

    .screenshot-frame {
      grid-column: 1 / span 8;
      margin-inline-end: clamp(-1rem, -1vw, 0);
    }

    .product-view__copy {
      grid-column: 9 / -1;
      padding-inline-start: var(--space-2);
      padding-block: var(--space-6);
    }

    .annotations li::before {
      position: absolute;
      top: 1.45rem;
      left: -2.75rem;
      width: 2.25rem;
      height: 1px;
      background: var(--line-accent);
      content: '';
      opacity: 0.85;
    }
  }

  @media (min-width: 80rem) {
    .screenshot-frame {
      grid-column: 1 / span 9;
      margin-inline-start: clamp(-2rem, -1.5vw, -0.75rem);
    }

    .product-view__copy {
      grid-column: 10 / -1;
    }
  }

  @media (max-width: 40rem) {
    .screenshot-frame {
      padding: var(--space-2);
    }

    .annotations::before,
    .annotations li::before {
      display: none;
    }
  }
</style>
