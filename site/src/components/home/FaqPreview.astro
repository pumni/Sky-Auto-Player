---
import type { HomeContent } from '../../data/home.types';
import { withBase } from '../../utils/urls';
import SectionIntro from '../ui/SectionIntro.astro';

interface Props {
  data: HomeContent['faqPreview'];
  locale: 'en' | 'vi';
}

const { data, locale } = Astro.props;
const isVi = locale === 'vi';
const faqUrl = withBase(isVi ? '/vi/faq/' : '/faq/');
---

<section
  id="faq-preview"
  class="faq-section section-shell section-shell--compact section-shell--bordered"
  aria-labelledby="faq-preview-title"
>
  <div class="container faq-preview__layout">
    <div class="faq-preview__heading">
      <SectionIntro
        kicker={data.kicker}
        title={data.title}
        titleId="faq-preview-title"
        measure="narrow"
      />
      <a class="text-link" href={faqUrl}>{data.readMoreLink}<span aria-hidden="true"> →</span></a>
    </div>

    <ul class="faq-teasers">
      {
        data.items.map((item) => (
          <li>
            <a class="faq-teasers__link" href={withBase(item.href)}>
              <span class="faq-teasers__q">{item.question}</span>
              <span class="faq-teasers__go" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .faq-preview__layout {
    display: grid;
    gap: var(--space-7);
  }

  .faq-section {
    background: color-mix(in oklch, var(--color-surface-quiet) 22%, var(--color-page));
  }

  @media (min-width: 64rem) {
    .faq-preview__layout {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: var(--grid-gap);
      align-items: start;
      /* Soft inset so FAQ reads lighter than adjacent utility blocks. */
      padding-inline: clamp(0rem, 4vw, 4rem);
    }
  }

  .faq-preview__heading {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .text-link {
    min-height: 44px;
    align-content: center;
    color: var(--color-action);
    font-weight: 650;
  }

  .faq-teasers {
    max-width: 58rem;
    margin: 0;
    padding: 0;
    border-block-start: 1px solid var(--line-default);
    list-style: none;
  }

  .faq-teasers li {
    border-block-end: 1px solid var(--line-faint);
  }

  .faq-teasers__link {
    display: flex;
    min-height: 56px;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    color: var(--color-text-primary);
  }

  .faq-teasers__q {
    min-width: 0;
    font-weight: 600;
    line-height: var(--leading-ui);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .faq-teasers__link:hover .faq-teasers__q,
  .faq-teasers__link:focus-visible .faq-teasers__q {
    color: var(--color-action-soft);
  }

  .faq-teasers__go {
    flex: 0 0 auto;
    color: var(--color-action);
    font-family: var(--font-mono);
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .faq-teasers__link:hover .faq-teasers__go,
  .faq-teasers__link:focus-visible .faq-teasers__go {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-teasers__link:hover .faq-teasers__go,
    .faq-teasers__link:focus-visible .faq-teasers__go {
      transform: none;
    }
  }
</style>
