---
import type { HomeContent } from '../../data/home.types';

interface Props {
  data: HomeContent['formats'];
  locale: 'en' | 'vi';
}
const { data, locale } = Astro.props;
---
<section id="formats" class="section-shell" aria-labelledby="formats-title">
  <div class="container">
    <div class="section-heading">
      <p class="kicker">{data.kicker}</p>
      <h2 id="formats-title" class="section-title">{data.title}</h2>
    </div>
    <div class="format-list">
      {data.items.map(item => (
        <div class="format-row">
          <div class="format-row__extension">{item.extension}</div>
          <div>
            <div class="format-row__name">{item.name}</div>
            <p class="format-row__description">{item.description}</p>
          </div>
          <div class="format-row__tags">{item.tags}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .kicker {
    font-weight: 700;
    color: var(--color-text-muted);
    text-transform: uppercase;
    font-size: var(--font-size-xs);
    letter-spacing: 0.1em;
    margin-bottom: var(--space-2);
  }
  .section-title {
    margin-bottom: var(--space-6);
  }
  .format-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .format-row {
    display: grid;
    gap: var(--space-4);
    background: var(--color-surface-1);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-panel);
    padding: var(--space-4);
    align-items: center;
  }
  @media (min-width: 40rem) {
    .format-row {
      grid-template-columns: 120px 1fr 200px;
    }
  }
  .format-row__extension {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: var(--font-size-lead);
    color: var(--color-text);
  }
  .format-row__name {
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  .format-row__description {
    color: var(--color-text-subtle);
    font-size: var(--font-size-sm);
  }
  .format-row__tags {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    text-align: right;
  }
  @media (max-width: 40rem) {
    .format-row__tags {
      text-align: left;
    }
  }
</style>
