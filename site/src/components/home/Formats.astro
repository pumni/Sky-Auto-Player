---
import type { HomeContent } from '../../data/home.types';
import SectionIntro from '../ui/SectionIntro.astro';

interface Props {
  data: HomeContent['formats'];
  locale: 'en' | 'vi';
}

const { data } = Astro.props;
---

<section
  id="formats"
  class="formats-section section-shell section-shell--compact"
  aria-labelledby="formats-title"
>
  <div class="container formats__layout">
    <SectionIntro
      kicker={data.kicker}
      title={data.title}
      titleId="formats-title"
      measure="narrow"
    />
    <div class="format-list">
      {
        data.items.map((item) => (
          <div class="format-row">
            <div class="format-row__extension">{item.extension}</div>
            <div class="format-row__copy">
              <div class="format-row__name">{item.name}</div>
              <p class="format-row__description">{item.description}</p>
            </div>
            <div class="format-row__tags">{item.tags}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .formats__layout {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 72rem) {
    .formats__layout {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: var(--grid-gap);
      align-items: start;
    }
  }

  .format-list {
    margin: 0;
    border-block-start: 1px solid var(--line-default);
  }

  .format-row {
    display: grid;
    gap: var(--space-3);
    align-items: baseline;
    padding-block: var(--space-4);
    border-block-end: 1px solid var(--line-faint);
  }

  .format-row__extension {
    min-width: 0;
    color: var(--color-action-soft);
    font-family: var(--font-mono);
    font-size: clamp(2.25rem, 3.25vw, 3.25rem);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.08em;
    line-height: 1;
    white-space: nowrap;
  }

  .format-row__copy {
    min-width: 0;
  }

  .format-row__name {
    margin-block-end: var(--space-1);
    color: var(--color-text-primary);
    font-weight: 650;
  }

  .format-row__description {
    color: var(--color-text-tertiary);
    font-size: var(--type-small);
  }

  .format-row__tags {
    min-width: 0;
    color: var(--color-info);
    font-family: var(--font-mono);
    font-size: var(--type-micro);
    letter-spacing: 0.06em;
    overflow-wrap: anywhere;
  }

  @media (min-width: 52rem) {
    .format-row {
      grid-template-columns: minmax(12rem, 15rem) minmax(0, 1fr) minmax(8rem, max-content);
      gap: var(--space-5);
    }

    .format-row__tags {
      justify-self: end;
      text-align: end;
    }
  }

  @media (min-width: 100rem) {
    .format-row__extension {
      font-size: 2.75rem;
    }
  }
</style>
