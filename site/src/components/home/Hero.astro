---
import type { HomeContent } from '../../data/home.types';
import { SITE } from '../../data/site';
import { withBase } from '../../utils/urls';
import Kicker from '../ui/Kicker.astro';
import TimingConsole from './TimingConsole.astro';

interface Props {
  data: HomeContent['hero'];
  locale: 'en' | 'vi';
}
const { data, locale } = Astro.props;
---

<section
  class="hero section-shell section-shell--feature section-shell--after-header"
  aria-labelledby="hero-title"
>
  <div class="container hero__layout">
    <div class="hero__copy">
      <Kicker>{data.kicker}</Kicker>
      <h1 id="hero-title">
        <span>{data.titleLines[0]}</span>{' '}
        <span class="hero__counterline">{data.titleLines[1]}</span>
      </h1>
      <p class="hero__description">{data.description}</p>
      <div class="hero__actions">
        <a class="button button--primary" href={SITE.releaseUrl}>{data.primaryCta}</a>
        <a
          class="button button--secondary"
          href={withBase(locale === 'vi' ? '/vi/#how-it-works' : '/#how-it-works')}
          >{data.secondaryCta}</a
        >
      </div>
      <ul
        class="metadata-strip"
        aria-label={locale === 'vi'
          ? 'Định dạng sheet và thông tin đóng gói'
          : 'Supported packaging and sheet metadata'}
      >
        {
          data.metadata.map((item) => (
            <li>
              <span class="metadata-strip__dot" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
      <p class="risk-note">
        {data.riskNote}{' '}
        <a href={withBase(locale === 'vi' ? '/vi/faq/#account-safety' : '/faq/#account-safety')}
          >{data.riskNoteLink}</a
        >
      </p>
    </div>
    <div class="hero__visual">
      <span class="hero__score-lines" aria-hidden="true"></span>
      <TimingConsole locale={locale} />
    </div>
  </div>
</section>

<style>
  .hero {
    border-top: 0;
  }

  .hero__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
  }

  .hero__copy,
  .hero__visual {
    min-width: 0;
  }

  .hero__copy {
    max-width: 38rem;
  }

  .hero h1 {
    max-width: 11ch;
  }

  .hero h1 span {
    display: block;
  }

  .hero__counterline {
    color: var(--color-text-secondary);
  }

  .hero__description {
    max-inline-size: 48ch;
    margin-block: var(--space-5);
    color: var(--color-text-tertiary);
    font-size: var(--type-lead);
    line-height: var(--leading-lead);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-block-end: var(--space-6);
  }

  .metadata-strip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-block-end: var(--space-4);
    padding: 0;
    color: var(--color-text-secondary);
    font-size: var(--type-label);
    list-style: none;
  }

  .metadata-strip li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 1.25rem;
  }

  .metadata-strip__dot {
    width: 0.35rem;
    height: 0.35rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--color-action);
    opacity: 0.85;
  }

  .risk-note {
    color: var(--color-text-secondary);
    font-size: var(--type-small);
  }

  .risk-note a {
    color: var(--color-text-primary);
    text-decoration: underline;
  }

  .hero__visual {
    position: relative;
  }

  .hero__visual > :not(.hero__score-lines) {
    position: relative;
    z-index: 1;
  }

  .hero__score-lines {
    position: absolute;
    inset: 12% 0 auto 8%;
    block-size: 38%;
    background: repeating-linear-gradient(
      to bottom,
      var(--line-faint) 0 1px,
      transparent 1px 1.1rem
    );
    opacity: 0.65;
    pointer-events: none;
    mask-image: linear-gradient(90deg, transparent, black 18%, black 82%, transparent);
  }

  @media (min-width: 64rem) {
    .hero__layout {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--grid-gap);
    }

    .hero__copy {
      grid-column: 1 / span 5;
    }

    .hero__visual {
      grid-column: 6 / -1;
      margin-inline-end: 0;
    }
  }

  @media (max-width: 40rem) {
    .hero__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero__actions .button {
      width: 100%;
    }
  }
</style>
