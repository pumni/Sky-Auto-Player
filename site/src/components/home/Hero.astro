---
import type { HomeContent } from '../../data/home.types';
import { SITE } from '../../data/site';
import { withBase } from '../../utils/urls';
import TimingConsole from './TimingConsole.astro';

interface Props {
  data: HomeContent['hero'];
  locale: 'en' | 'vi';
}
const { data, locale } = Astro.props;
---

<section
  class="hero section-shell section-shell--feature section-shell--after-header"
  aria-labelledby="hero-title"
>
  <div class="container hero__layout">
    <div class="hero__copy">
      <p class="kicker">{data.kicker}</p>
      <h1 id="hero-title"><span>{data.titleLines[0]}</span><span>{data.titleLines[1]}</span></h1>
      <p class="hero__description">{data.description}</p>
      <div class="hero__actions">
        <a class="button button--primary" href={SITE.releaseUrl}>{data.primaryCta}</a>
        <a
          class="button button--secondary"
          href={withBase(locale === 'vi' ? '/vi/#how-it-works' : '/#how-it-works')}
          >{data.secondaryCta}</a
        >
      </div>
      <ul
        class="metadata-strip"
        aria-label={locale === 'vi'
          ? 'Định dạng sheet và thông tin đóng gói'
          : 'Supported packaging and sheet metadata'}
      >
        {
          data.metadata.map((item) => (
            <li>
              <span class="metadata-strip__dot" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
      <p class="risk-note">
        {data.riskNote}{' '}
        <a href={withBase(locale === 'vi' ? '/vi/faq/#account-safety' : '/faq/#account-safety')}
          >{data.riskNoteLink}</a
        >
      </p>
    </div>
    <div class="hero__visual">
      <TimingConsole locale={locale} />
    </div>
  </div>
</section>

<style>
  .hero {
    border-top: 0;
  }
  .hero__layout {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }
  @media (min-width: 64rem) {
    .hero {
      border-top: 0;
    }
    .hero__layout {
      grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
    }
  }
  .kicker {
    font-weight: 700;
    color: var(--color-text-muted);
    text-transform: uppercase;
    font-size: var(--font-size-xs);
    letter-spacing: 0.1em;
    margin-bottom: var(--space-2);
  }
  .hero h1 {
    max-width: 100%;
  }
  .hero h1 span {
    display: block;
  }
  .hero__copy {
    max-width: 38rem;
  }
  .hero__description {
    font-size: var(--font-size-lead);
    color: var(--color-text-subtle);
    margin-block: var(--space-4);
  }
  .hero__actions {
    display: flex;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    flex-wrap: wrap;
  }
  .hero__copy,
  .hero__visual {
    min-width: 0;
  }
  .metadata-strip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
    list-style: none;
    padding: 0;
    margin-left: 0;
  }
  .metadata-strip li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 1.25rem;
  }
  .metadata-strip__dot {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--color-accent);
    flex: 0 0 auto;
    opacity: 0.85;
  }
  .risk-note {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }
  .risk-note a {
    color: var(--color-text);
    text-decoration: underline;
  }
  @media (max-width: 40rem) {
    .hero__actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero__actions .button {
      width: 100%;
    }
  }
</style>
