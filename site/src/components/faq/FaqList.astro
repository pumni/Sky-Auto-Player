---
import { getCollection } from 'astro:content';
import type { Locale } from '../../data/site';
import FaqItem from './FaqItem.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const allFaqs = await getCollection('faq', ({ data }) => data.locale === locale);
allFaqs.sort((a, b) => a.data.order - b.data.order);
---
<article class="faq-content">
  <h2>{locale === 'vi' ? 'Câu hỏi và trả lời' : 'Questions and answers'}</h2>
  <div class="faq-list">
    {allFaqs.map((faq, index) => (
      <FaqItem faq={faq} isOpen={index < 2} />
    ))}
  </div>
</article>

<style>
  .faq-content h2 {
    margin-bottom: var(--space-6);
  }
</style>
