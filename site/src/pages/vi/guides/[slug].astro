---
import { getCollection, render } from 'astro:content';
import GuideLayout from '../../../layouts/GuideLayout.astro';
import ArchitectureDiagram from '../../../components/guide/ArchitectureDiagram.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides', (g) => g.data.locale === 'vi' && !g.data.draft);
  return guides.map((guide) => ({
    params: { slug: guide.data.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);

// Resolve related guides by explicit key (guide.data.related) instead of category-match.
// Strictly validates missing key, self-reference, duplicate key, and draft target.
const allGuides = await getCollection('guides', (g) => g.data.locale === 'vi' && !g.data.draft);
const guideByKey = new Map(allGuides.map((g) => [g.data.key, g]));
const seenKeys = new Set<string>();

const relatedGuides = guide.data.related.map((relKey) => {
  if (relKey === guide.data.key) {
    throw new Error(
      `[related-guides] Guide "${guide.data.slug}" (${guide.data.locale}) self-references its own key: "${relKey}"`,
    );
  }
  if (seenKeys.has(relKey)) {
    throw new Error(
      `[related-guides] Guide "${guide.data.slug}" (${guide.data.locale}) has duplicate related key: "${relKey}"`,
    );
  }
  seenKeys.add(relKey);

  const target = guideByKey.get(relKey);
  if (!target) {
    throw new Error(
      `[related-guides] Guide "${guide.data.slug}" (${guide.data.locale}) references missing or draft target key: "${relKey}"`,
    );
  }
  return {
    title: target.data.title,
    slug: target.data.slug,
    locale: target.data.locale as 'en' | 'vi',
  };
});
---

<GuideLayout
  locale="vi"
  seo={{
    title: `${guide.data.title} — Sky Auto Player`,
    description: guide.data.description,
    ...(guide.data.image ? { image: guide.data.image, imageAlt: guide.data.imageAlt } : {}),
  }}
  guide={{
    title: guide.data.title,
    summary: guide.data.summary,
    category: guide.data.category,
    published: guide.data.published,
    updated: guide.data.updated,
    lastReviewedVersion: guide.data.lastReviewedVersion,
    evidence: guide.data.evidence,
    slug: guide.data.slug,
  }}
  relatedGuides={relatedGuides}
>
  <Content />
  {guide.data.showDiagram && <ArchitectureDiagram locale="vi" />}
</GuideLayout>
