---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideHub from '../../components/guide/GuideHub.astro';
import { SITE } from '../../data/site';
import { withBase } from '../../utils/urls';

const guides = await getCollection('guides', (g) => g.data.locale === 'en' && !g.data.draft);

const canonicalUrl = new URL(withBase('/guides/'), SITE.productionOrigin).href;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Sky Auto Player Guides',
  description:
    'Technical guides for Sky Auto Player: setup, timing model, sheet formats, security boundaries, and troubleshooting.',
  url: canonicalUrl,
  inLanguage: 'en',
  isPartOf: {
    '@id': new URL(withBase('/'), SITE.productionOrigin).href + '#website',
  },
};
---

<BaseLayout
  locale="en"
  seo={{
    title: 'Guides — Sky Auto Player',
    description:
      'Technical guides for Sky Auto Player on Windows: setup, timing model, sheet formats, security boundaries, and troubleshooting.',
  }}
  structuredData={structuredData}
>
  <div class="guides-hub-page section-shell section-shell--opening section-shell--after-header">
    <div class="container">
      <p class="kicker">Documentation</p>
      <h1>Sky Auto Player Guides</h1>
      <p class="guides-hub-page__intro">
        First-party guides covering setup, the timing model, supported sheet formats, technical
        boundaries, and troubleshooting — written against the current source code.
      </p>
    </div>
  </div>
  <div class="container guides-hub-page__body">
    <GuideHub locale="en" guides={guides} />
  </div>
</BaseLayout>

<style>
  .guides-hub-page {
    border-top: 0;
  }

  .guides-hub-page h1 {
    margin-block: var(--space-3) var(--space-4);
  }

  .guides-hub-page__intro {
    font-size: var(--type-lead);
    color: var(--color-text-secondary);
    max-inline-size: 60ch;
    line-height: var(--leading-lead);
    margin-block-end: 0;
  }

  .guides-hub-page__body {
    padding-block: var(--space-6) var(--space-16);
  }
</style>
