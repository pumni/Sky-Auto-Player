---
import { getCollection, render } from 'astro:content';
import GuideLayout from '../../layouts/GuideLayout.astro';
import ArchitectureDiagram from '../../components/guide/ArchitectureDiagram.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides', (g) => g.data.locale === 'en' && !g.data.draft);
  return guides.map((guide) => ({
    params: { slug: guide.data.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);

// Resolve related guides by explicit key (guide.data.related) instead of category-match.
// This guarantees related links even for single-guide categories.
const allGuides = await getCollection('guides', (g) => g.data.locale === 'en' && !g.data.draft);
const guideBySlug = new Map(allGuides.map((g) => [g.data.slug, g]));
const relatedGuides = guide.data.related
  .map((key) => guideBySlug.get(key))
  .filter((g): g is NonNullable<typeof g> => g !== undefined)
  .map((g) => ({ title: g.data.title, slug: g.data.slug, locale: g.data.locale as 'en' | 'vi' }));
---

<GuideLayout
  locale="en"
  seo={{
    title: `${guide.data.title} — Sky Auto Player`,
    description: guide.data.description,
    ...(guide.data.image ? { image: guide.data.image, imageAlt: guide.data.imageAlt } : {}),
  }}
  guide={{
    title: guide.data.title,
    summary: guide.data.summary,
    category: guide.data.category,
    published: guide.data.published,
    updated: guide.data.updated,
    lastReviewedVersion: guide.data.lastReviewedVersion,
    evidence: guide.data.evidence,
    slug: guide.data.slug,
  }}
  relatedGuides={relatedGuides}
>
  <Content />
  {guide.data.showDiagram && <ArchitectureDiagram locale="en" />}
</GuideLayout>
