# Local interpreter/test caches are ignored even though the product no longer
# uses Python; old worktrees can leave these artifacts behind.
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.pytest_tmp/
.ruff_cache/

# Project Logs (tránh commit các file log debug timing sinh ra khi chơi nhạc)
logs/
*.log

# IDEs and Editors
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Operating System Files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Local User Configurations
config.json

# Build Artifacts
build/
dist/
*.spec
!Sky-Auto-Player.spec
!Sky-Auto-Player-Core.spec
windows_version_info.txt

# Packaging Metadata
*.egg-info/

# Antigravity CLI Local Data (caches timing profiles and user settings, should not be committed)
.antigravitycli/

# Cache Files
.cache/
.benchmarks/
.tmp/

# Local uv environment overrides (copy from .env.example)
.env

# Pester test report artifacts (regenerated on every Invoke-Pester run, never
# source — also excluded from release zips by build_app.py's installer_ignore).
TestResults.xml
**/TestResults.xml

# Astro / Node website toolchain (also covered by site/.gitignore)
site/node_modules/
site/dist/
site/.astro/
site/playwright-report/
site/test-results/

# Legacy build_pages_site.ps1 output (script retired; directory must not be re-created).
_site/

# Rust build artifacts
rust/target/

# Desktop frontend/build artifacts
desktop/node_modules/
desktop/dist/
desktop/src-tauri/target/
desktop/src-tauri/gen/
desktop/test-results/

# Local benchmark worktree; never commit the linked checkout.
.bench-worktree/
