# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Virtual Environments
.venv/
venv/
env/
ENV/

# Project Logs (tránh commit các file log debug timing sinh ra khi chơi nhạc)
logs/
*.log

# IDEs and Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Operating System Files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Local User Configurations
config.json

# PyInstaller Build Artifacts
build/
dist/
*.spec
!Sky-Auto-Player.spec
windows_version_info.txt

# Packaging Metadata
*.egg-info/

# Antigravity CLI Local Data (caches timing profiles and user settings, should not be committed)
.antigravitycli/

# Cache Files
.cache/
.pytest_cache/
.uv-cache/
# pytest-benchmark storage (transient before/after measurements); committed
# perf baselines live under docs/perf-baselines/ instead.
.benchmarks/
.tmp/
.ruff_cache/

# Build-generated version file (rewritten by build_app.py)
src/sky_music/_version.py
# Build-generated native extension provenance (rewritten by build_app.py)
src/sky_music/_native_build.py

# Local uv environment overrides (copy from .env.example)
.env

# Pester test report artifacts (regenerated on every Invoke-Pester run, never
# source — also excluded from release zips by build_app.py's installer_ignore).
TestResults.xml
**/TestResults.xml

# Astro / Node website toolchain (also covered by site/.gitignore)
site/node_modules/
site/dist/
site/.astro/
site/playwright-report/
site/test-results/

# Legacy build_pages_site.ps1 output (script retired; directory must not be re-created).
_site/

# Rust build artifacts
rust/target/
